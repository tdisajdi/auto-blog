{
 "ID": 69,
 "URL": "https://ondo99.com/insights/",
 "categories": [],
 "content": "\n<div id=\"ondo-hub-page\">\n<style>\n  #ondo-hub-page {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Malgun Gothic', sans-serif;\n    background: #0e1a30;\n    color: #e8ecf4;\n  }\n  #ondo-hub-page * { box-sizing: border-box; }\n  #ondo-hub-page { word-break: keep-all; overflow-wrap: break-word; }\n\n  #ondo-hub-page .hub-inner {\n    max-width: 1180px;\n    margin: 0 auto;\n    padding: 0 24px;\n  }\n\n  /* ── 히어로 배너 ── */\n  #ondo-hub-page .hub-hero {\n    position: relative;\n    width: 100%;\n    height: 560px;\n    background: linear-gradient(180deg, #22355c 0%, #101c33 100%);\n    overflow: hidden;\n  }\n  #ondo-hub-page .hub-hero img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  #ondo-hub-page .hub-hero::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(14,26,48,0.2) 0%, rgba(14,26,48,0.45) 60%, #0e1a30 100%);\n    pointer-events: none;\n  }\n  #ondo-hub-page .hub-hero-txt {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n    z-index: 2;\n    padding: 0 20px;\n  }\n  /* [시안] DATA-DRIVEN 작게 + INSIGHTS 초대형 2단 구성 */\n  #ondo-hub-page .hub-hero-kicker {\n    font-family: 'Montserrat', -apple-system, sans-serif;\n    font-size: 24px;\n    font-weight: 800;\n    letter-spacing: 8px;\n    color: #e8b944;\n    margin: 0 0 4px;\n    text-shadow: 0 2px 18px rgba(0,0,0,0.5);\n  }\n  #ondo-hub-page .hub-hero-title {\n    font-family: 'Montserrat', -apple-system, sans-serif;\n    font-size: 110px;\n    font-weight: 900;\n    letter-spacing: 6px;\n    color: #e8b944;\n    line-height: 1.02;\n    margin: 0;\n    text-shadow: 0 4px 30px rgba(0,0,0,0.5);\n  }\n  #ondo-hub-page .hub-hero-sub {\n    margin-top: 20px;\n    font-size: 17px;\n    font-weight: 500;\n    color: #f2f4f8;\n    letter-spacing: 0.4px;\n    text-shadow: 0 1px 12px rgba(0,0,0,0.55);\n  }\n\n  /* ── 섹션 헤더 (아이콘 + 타이틀 + 카피) ── */\n  #ondo-hub-page .hub-secthead {\n    text-align: center;\n    padding: 60px 20px 42px;\n  }\n  #ondo-hub-page .hub-secthead .icon-ring {\n    width: 54px;\n    height: 54px;\n    margin: 0 auto 20px;\n    border: 1.5px solid #e8b944;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 22px;\n    color: #e8b944;\n    position: relative;\n  }\n  #ondo-hub-page .hub-secthead .icon-ring::before,\n  #ondo-hub-page .hub-secthead .icon-ring::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    width: 54px;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(232,185,68,0.55));\n  }\n  #ondo-hub-page .hub-secthead .icon-ring::before { right: 100%; margin-right: 14px; }\n  #ondo-hub-page .hub-secthead .icon-ring::after { left: 100%; margin-left: 14px; transform: scaleX(-1); }\n  /* [시안] 세리프 → 대문자 헤비 산세리프 */\n  #ondo-hub-page .hub-secthead h2 {\n    font-family: 'Montserrat', -apple-system, sans-serif;\n    font-size: 32px;\n    font-weight: 800;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 16px;\n    letter-spacing: 1.5px;\n  }\n  #ondo-hub-page .hub-secthead p {\n    font-size: 15px;\n    color: #b9c3d6;\n    line-height: 1.8;\n    margin: 0;\n  }\n  #ondo-hub-page .hub-secthead p b { color: #dfe5ef; font-weight: 600; }\n\n  /* ── 카테고리 카드 공통 ── */\n  #ondo-hub-page .hub-cards { padding-bottom: 8px; }\n  #ondo-hub-page .hub-card {\n    position: relative;\n    display: block;\n    border: 1px solid rgba(232,185,68,0.28);\n    border-radius: 16px;\n    overflow: hidden;\n    margin-bottom: 26px;\n    background: #101d36;\n    text-decoration: none;\n    color: inherit;\n    cursor: pointer;\n    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;\n  }\n  #ondo-hub-page .hub-card:hover {\n    transform: translateY(-4px);\n    border-color: rgba(232,185,68,0.85);\n    box-shadow: 0 14px 38px rgba(0,0,0,0.45);\n  }\n  #ondo-hub-page .hub-card img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: right center;\n    display: block;\n    position: absolute;\n    inset: 0;\n  }\n  /* [시안] 좌측 텍스트가 읽히도록 좌→우 그라데이션 */\n  #ondo-hub-page .hub-card::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(90deg, rgba(10,18,36,0.96) 0%, rgba(10,18,36,0.82) 38%, rgba(10,18,36,0.35) 68%, rgba(10,18,36,0.12) 100%);\n    pointer-events: none;\n  }\n  /* [시안] 텍스트 블록: 좌측 정렬 + 세로 중앙 */\n  #ondo-hub-page .hub-card-txt {\n    position: absolute;\n    left: 36px;\n    right: 30%;\n    top: 0;\n    bottom: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    z-index: 2;\n  }\n  /* [시안] 카테고리명을 초대형 골드 타이틀로 */\n  #ondo-hub-page .hub-card-cat {\n    font-family: 'Montserrat', -apple-system, sans-serif;\n    font-size: 58px;\n    font-weight: 900;\n    letter-spacing: 2px;\n    line-height: 1.04;\n    color: #e8b944;\n    margin-bottom: 8px;\n    text-shadow: 0 2px 16px rgba(0,0,0,0.5);\n  }\n  /* [시안] 영문 태그라인 (카테고리명 아래 소형 화이트 대문자) */\n  #ondo-hub-page .hub-card-tag {\n    font-size: 12.5px;\n    font-weight: 700;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: #eef1f7;\n    margin-bottom: 16px;\n    padding-bottom: 12px;\n    position: relative;\n  }\n  #ondo-hub-page .hub-card-tag::after {\n    content: '';\n    position: absolute;\n    left: 0;\n    bottom: 0;\n    width: 44px;\n    height: 2px;\n    background: #e8b944;\n  }\n  #ondo-hub-page .hub-card-title {\n    font-size: 21px;\n    font-weight: 700;\n    color: #ffffff;\n    line-height: 1.42;\n    margin: 0;\n    text-shadow: 0 1px 10px rgba(0,0,0,0.55);\n  }\n  #ondo-hub-page .hub-card-arr {\n    position: absolute;\n    right: 28px;\n    bottom: 26px;\n    z-index: 2;\n    color: #e8b944;\n    font-size: 26px;\n    line-height: 1;\n    transition: transform .2s;\n  }\n  #ondo-hub-page .hub-card:hover .hub-card-arr { transform: translateX(6px); }\n\n  /* 큰 카드 / 반쪽 카드 */\n  #ondo-hub-page .hub-card.is-wide { height: 300px; }\n  #ondo-hub-page .hub-row {\n    display: flex;\n    gap: 26px;\n    margin-bottom: 26px;\n  }\n  #ondo-hub-page .hub-row .hub-card {\n    flex: 1;\n    min-width: 0;\n    height: 240px;\n    margin-bottom: 0;\n  }\n  #ondo-hub-page .hub-row .hub-card .hub-card-txt { left: 28px; right: 26%; }\n  #ondo-hub-page .hub-row .hub-card .hub-card-cat { font-size: 30px; letter-spacing: 1.2px; }\n  #ondo-hub-page .hub-row .hub-card .hub-card-tag { font-size: 11px; margin-bottom: 12px; padding-bottom: 10px; }\n  #ondo-hub-page .hub-row .hub-card .hub-card-title { font-size: 16px; }\n\n  /* is-empty(글 없음) 상태 — [시안] \"곧 공개됩니다\"는 골드로 */\n  #ondo-hub-page .hub-card.is-empty .hub-card-title {\n    color: #e8b944;\n    font-size: 17px;\n    font-weight: 700;\n  }\n\n  /* ── 마켓 대시보드 (세계시계 + 환율) ── */\n  #ondo-hub-page .hub-dash {\n    display: flex;\n    gap: 26px;\n    padding-bottom: 64px;\n  }\n  #ondo-hub-page .hub-dash-card {\n    flex: 1;\n    min-width: 0;\n    background: #16233d;\n    border: 1px solid rgba(232,185,68,0.35);\n    border-radius: 14px;\n    padding: 26px 28px;\n  }\n  #ondo-hub-page .hub-dash-title {\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: 2.6px;\n    color: #e8b944;\n    margin: 0 0 20px;\n  }\n\n  /* 세계시계 */\n  #ondo-hub-page .hub-clock-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 13px 0;\n    border-bottom: 1px solid rgba(255,255,255,0.07);\n  }\n  #ondo-hub-page .hub-clock-row:last-child { border-bottom: none; }\n  #ondo-hub-page .hub-clock-city {\n    font-size: 14px;\n    font-weight: 700;\n    color: #dfe5ef;\n    width: 120px;\n    letter-spacing: 0.5px;\n  }\n  #ondo-hub-page .hub-clock-city small {\n    font-size: 13px;\n    font-weight: 700;\n    color: #dfe5ef;\n    letter-spacing: 0.8px;\n    margin-left: 5px;\n  }\n  #ondo-hub-page .hub-clock-time {\n    font-family: 'Courier New', monospace;\n    font-size: 19px;\n    font-weight: 700;\n    color: #ffffff;\n    letter-spacing: 3px;\n    flex: 1;\n    text-align: center;\n  }\n  /* [시안] OPEN = 골드 알약 / CLOSED = 회색 알약 */\n  #ondo-hub-page .hub-clock-status {\n    font-size: 11px;\n    font-weight: 800;\n    letter-spacing: 1.6px;\n    padding: 5px 0;\n    border-radius: 20px;\n    width: 82px;\n    text-align: center;\n  }\n  #ondo-hub-page .hub-clock-status.is-open {\n    color: #14203a;\n    background: #e8b944;\n    border: 1px solid #e8b944;\n  }\n  #ondo-hub-page .hub-clock-status.is-closed {\n    color: #9aa5ba;\n    background: rgba(255,255,255,0.06);\n    border: 1px solid rgba(255,255,255,0.14);\n  }\n\n  /* 환율 — [시안] 값은 골드 */\n  #ondo-hub-page .hub-fx-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 13px 0;\n    border-bottom: 1px solid rgba(255,255,255,0.07);\n  }\n  #ondo-hub-page .hub-fx-row:last-child { border-bottom: none; }\n  #ondo-hub-page .hub-fx-label {\n    font-size: 14px;\n    font-weight: 700;\n    color: #dfe5ef;\n    letter-spacing: 0.4px;\n  }\n  #ondo-hub-page .hub-fx-label small {\n    display: block;\n    font-size: 11px;\n    font-weight: 500;\n    color: #7f8ba1;\n    margin-top: 2px;\n  }\n  #ondo-hub-page .hub-fx-val {\n    font-family: 'Courier New', monospace;\n    font-size: 19px;\n    font-weight: 700;\n    color: #e8b944;\n    letter-spacing: 0.5px;\n    text-align: right;\n  }\n  #ondo-hub-page .hub-fx-note {\n    font-size: 10px;\n    color: #66738c;\n    text-align: right;\n    margin-top: 14px;\n  }\n  #ondo-hub-page .hub-fx-loading {\n    padding: 30px 0;\n    text-align: center;\n    color: #8b96ac;\n    font-size: 13px;\n  }\n\n  /* ── 푸터 ── */\n  #ondo-hub-page .hub-footer {\n    border-top: 1px solid rgba(255,255,255,0.08);\n    padding: 44px 0 34px;\n  }\n  #ondo-hub-page .hub-footer-cols {\n    display: flex;\n    gap: 48px;\n    flex-wrap: wrap;\n  }\n  #ondo-hub-page .hub-footer-brand {\n    font-family: 'Montserrat', -apple-system, sans-serif;\n    font-size: 22px;\n    font-weight: 900;\n    letter-spacing: 1.6px;\n    color: #e8b944;\n    line-height: 1.3;\n  }\n  #ondo-hub-page .hub-footer h4 {\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 2.4px;\n    color: #ffffff;\n    margin: 0 0 12px;\n  }\n  #ondo-hub-page .hub-footer p {\n    font-size: 13px;\n    color: #98a3b8;\n    line-height: 1.9;\n    margin: 0;\n  }\n  #ondo-hub-page .hub-copy {\n    text-align: center;\n    font-size: 12px;\n    letter-spacing: 1.4px;\n    color: #66738c;\n    padding: 30px 0 10px;\n  }\n\n  /* ── 반응형 ── */\n  @media (max-width: 860px) {\n    #ondo-hub-page .hub-hero { height: 400px; }\n    #ondo-hub-page .hub-hero-kicker { font-size: 15px; letter-spacing: 5px; }\n    #ondo-hub-page .hub-hero-title { font-size: 56px; letter-spacing: 3px; }\n    #ondo-hub-page .hub-hero-sub { font-size: 13px; }\n    #ondo-hub-page .hub-secthead h2 { font-size: 23px; letter-spacing: 1px; }\n    #ondo-hub-page .hub-row { flex-direction: column; gap: 20px; margin-bottom: 20px; }\n    #ondo-hub-page .hub-card { margin-bottom: 20px; }\n    #ondo-hub-page .hub-card.is-wide { height: 240px; }\n    #ondo-hub-page .hub-row .hub-card { height: 200px; }\n    #ondo-hub-page .hub-card-txt { left: 22px; right: 18%; }\n    #ondo-hub-page .hub-card-cat { font-size: 36px; }\n    #ondo-hub-page .hub-card-tag { font-size: 10.5px; letter-spacing: 1.4px; }\n    #ondo-hub-page .hub-card-title { font-size: 16px; }\n    #ondo-hub-page .hub-row .hub-card .hub-card-cat { font-size: 26px; }\n    #ondo-hub-page .hub-dash { flex-direction: column; gap: 20px; }\n    #ondo-hub-page .hub-clock-time { font-size: 15px; letter-spacing: 2px; }\n    #ondo-hub-page .hub-footer-cols { gap: 26px; }\n  }\n</style>\n\n  <!-- ★★★ 배너 사진: 아래 src의 따옴표 안에 이미지 URL을 붙여넣으세요 ★★★\n       (기존 페이지와 동일 — URL이 없으면 미디어 라이브러리에서 자동으로 찾습니다) -->\n  <div class=\"hub-hero\">\n    <img decoding=\"async\" src=\"여기에-배너-이미지-URL-붙여넣기\" alt=\"\" onerror=\"this.style.display='none'\" />\n    <div class=\"hub-hero-txt\">\n      <div class=\"hub-hero-kicker\">DATA-DRIVEN</div>\n      <h1 class=\"hub-hero-title\">INSIGHTS</h1>\n      <div class=\"hub-hero-sub\">ETFs, trends, technology and the world &mdash; explained with data</div>\n    </div>\n  </div>\n\n  <!-- 인트로 -->\n  <div class=\"hub-inner\">\n    <div class=\"hub-secthead\">\n      <div class=\"icon-ring\">&#128196;</div>\n      <h2 id=\"hubIntroTitle\">Premium Insights, Curated Daily</h2>\n      <p id=\"hubIntroDesc\">데이터를 통찰하고, 인사이트로 앞서갑니다.<br><b>ETF, 트렌드, 신기술, 바이오, 에너지, 사회</b> — 데이터로 세상의 흐름을 읽습니다.</p>\n    </div>\n\n    <!-- 카테고리 카드 (세로 배치: 큰카드 → 2단 → 큰카드) -->\n    <div class=\"hub-cards\" id=\"hubCards\">\n      <!-- ETF : 큰 카드 -->\n      <a class=\"hub-card is-wide\" data-hubcat=\"etf\">\n        <img decoding=\"async\" data-hubimg=\"etf\" src=\"\" alt=\"\" onerror=\"this.style.display='none'\" />\n        <div class=\"hub-card-txt\">\n          <div class=\"hub-card-cat\">ETF</div>\n          <div class=\"hub-card-tag\">Diversified. Transparent. Growth-Focused.</div>\n          <div class=\"hub-card-title\" data-hubtitle=\"etf\">불러오는 중&#8230;</div>\n        </div>\n        <span class=\"hub-card-arr\">&#8594;</span>\n      </a>\n\n      <!-- Trend / Tech & Patents : 2단 -->\n      <div class=\"hub-row\">\n      <a class=\"hub-card\" data-hubcat=\"trend\">\n        <img decoding=\"async\" data-hubimg=\"trend\" src=\"\" alt=\"\" onerror=\"this.style.display='none'\" />\n        <div class=\"hub-card-txt\">\n          <div class=\"hub-card-cat\">TREND</div>\n          <div class=\"hub-card-tag\">What People Are Talking About.</div>\n          <div class=\"hub-card-title\" data-hubtitle=\"trend\">불러오는 중&#8230;</div>\n        </div>\n        <span class=\"hub-card-arr\">&#8594;</span>\n      </a>\n      <a class=\"hub-card\" data-hubcat=\"patents\">\n        <img decoding=\"async\" data-hubimg=\"patents\" src=\"\" alt=\"\" onerror=\"this.style.display='none'\" />\n        <div class=\"hub-card-txt\">\n          <div class=\"hub-card-cat\">TECH &amp;<br>PATENTS</div>\n          <div class=\"hub-card-tag\">Ideas That Shape Tomorrow.</div>\n          <div class=\"hub-card-title\" data-hubtitle=\"patents\">불러오는 중&#8230;</div>\n        </div>\n        <span class=\"hub-card-arr\">&#8594;</span>\n      </a>\n      </div>\n\n      <!-- Biotech / Energy : 2단 -->\n      <div class=\"hub-row\">\n      <a class=\"hub-card\" data-hubcat=\"biotech\">\n        <img decoding=\"async\" data-hubimg=\"biotech\" src=\"\" alt=\"\" onerror=\"this.style.display='none'\" />\n        <div class=\"hub-card-txt\">\n          <div class=\"hub-card-cat\">BIOTECH /<br>NEW DRUGS</div>\n          <div class=\"hub-card-tag\">Innovation. Discovery. Transformation.</div>\n          <div class=\"hub-card-title\" data-hubtitle=\"biotech\">불러오는 중&#8230;</div>\n        </div>\n        <span class=\"hub-card-arr\">&#8594;</span>\n      </a>\n      <a class=\"hub-card\" data-hubcat=\"energy\">\n        <img decoding=\"async\" data-hubimg=\"energy\" src=\"\" alt=\"\" onerror=\"this.style.display='none'\" />\n        <div class=\"hub-card-txt\">\n          <div class=\"hub-card-cat\">ENERGY &amp;<br>CLIMATE</div>\n          <div class=\"hub-card-tag\">Power. Resources. Planet.</div>\n          <div class=\"hub-card-title\" data-hubtitle=\"energy\">불러오는 중&#8230;</div>\n        </div>\n        <span class=\"hub-card-arr\">&#8594;</span>\n      </a>\n      </div>\n\n      <!-- Society : 큰 카드 -->\n      <a class=\"hub-card is-wide\" data-hubcat=\"society\">\n        <img decoding=\"async\" data-hubimg=\"society\" src=\"\" alt=\"\" onerror=\"this.style.display='none'\" />\n        <div class=\"hub-card-txt\">\n          <div class=\"hub-card-cat\">SOCIETY</div>\n          <div class=\"hub-card-tag\">How We Live Is Changing.</div>\n          <div class=\"hub-card-title\" data-hubtitle=\"society\">불러오는 중&#8230;</div>\n        </div>\n        <span class=\"hub-card-arr\">&#8594;</span>\n      </a>\n    </div>\n\n    <!-- 마켓 대시보드 (구독 섹션 대체) -->\n    <div class=\"hub-secthead\">\n      <div class=\"icon-ring\">&#127760;</div>\n      <h2 id=\"hubDashTitle\">Global Markets, Live</h2>\n      <p id=\"hubDashDesc\">지금 이 순간의 글로벌 시장 — 주요 거래소와 환율을 한눈에.</p>\n    </div>\n\n    <div class=\"hub-dash\">\n      <!-- 세계시계 + 거래소 상태 -->\n      <div class=\"hub-dash-card\">\n        <div class=\"hub-dash-title\">WORLD MARKETS</div>\n        <div id=\"hubClocks\"></div>\n      </div>\n\n      <!-- 환율 요약 -->\n      <div class=\"hub-dash-card\">\n        <div class=\"hub-dash-title\">EXCHANGE RATES</div>\n        <div id=\"hubFx\"><div class=\"hub-fx-loading\">불러오는 중&#8230;</div></div>\n        <div class=\"hub-fx-note\">데이터 제공: Frankfurter (ECB)</div>\n      </div>\n    </div>\n\n    <!-- 푸터 -->\n    <div class=\"hub-footer\">\n      <div class=\"hub-footer-cols\">\n        <div style=\"flex:1.2;min-width:200px;\">\n          <div class=\"hub-footer-brand\">DATA-DRIVEN<br>INSIGHTS</div>\n        </div>\n        <div style=\"flex:1;min-width:180px;\">\n          <h4>ABOUT</h4>\n          <p>데이터 기반 인사이트로<br>투자 경험을 지원하는<br>프리미엄 정보 플랫폼입니다.</p>\n        </div>\n        <div style=\"flex:1;min-width:150px;\">\n          <h4>LEGAL</h4>\n          <p>이용약관<br>개인정보처리방침<br>저작권 안내</p>\n        </div>\n        <div style=\"flex:1;min-width:200px;\">\n          <h4>CONTACT</h4>\n          <p>제휴 및 광고 문의<br>파트너십 문의</p>\n        </div>\n      </div>\n      <div class=\"hub-copy\">&copy; 2026 DATA-DRIVEN INSIGHTS. ALL RIGHTS RESERVED.</div>\n    </div>\n  </div>\n</div>\n\n<script type=\"text/plain\" id=\"ondo-page-code\">\n(function () {\n  var SITE_API = 'https://ondo99.com/wp-json/wp/v2';\n\n  /* ── 언어 감지 ── */\n  var KO = ((navigator.language || navigator.userLanguage || '') + '').toLowerCase().indexOf('ko') === 0;\n  var T = KO ? {\n    loading: '불러오는 중...',\n    comingSoon: '곧 공개됩니다',\n    introTitle: 'Premium Insights, Curated Daily',\n    introDesc: '데이터를 통찰하고, 인사이트로 앞서갑니다.<br><b>ETF, 트렌드, 신기술, 바이오, 에너지, 사회</b> — 데이터로 세상의 흐름을 읽습니다.',\n    dashTitle: 'Global Markets, Live',\n    dashDesc: '지금 이 순간의 글로벌 시장 — 주요 거래소와 환율을 한눈에.',\n    open: 'OPEN',\n    closed: 'CLOSED',\n    fxError: '환율 정보를 불러오지 못했습니다.'\n  } : {\n    loading: 'Loading...',\n    comingSoon: 'Coming Soon',\n    introTitle: 'Premium Insights, Curated Daily',\n    introDesc: 'See through the data, stay ahead with insights.<br><b>ETFs, trends, tech, biotech, energy and society</b> — reading the world through data.',\n    dashTitle: 'Global Markets, Live',\n    dashDesc: 'Global markets at this very moment — key exchanges and rates at a glance.',\n    open: 'OPEN',\n    closed: 'CLOSED',\n    fxError: 'Could not load exchange rates.'\n  };\n  document.getElementById('hubIntroTitle').textContent = T.introTitle;\n  document.getElementById('hubIntroDesc').innerHTML = T.introDesc;\n  document.getElementById('hubDashTitle').textContent = T.dashTitle;\n  document.getElementById('hubDashDesc').textContent = T.dashDesc;\n  document.querySelectorAll('#ondo-hub-page [data-hubtitle]').forEach(function (n) { n.textContent = T.loading; });\n\n  /* ── 테마 폭 제한 탈출 + 상단 헤더 덮기 (기존 페이지와 동일 로직) ── */\n  var COVER_TOP = true;\n  function fullBleed() {\n    var el = document.getElementById('ondo-hub-page');\n    if (!el) return;\n    el.style.position = 'relative';\n    el.style.zIndex = '10';\n    el.style.setProperty('margin-left', '0px', 'important');\n    el.style.setProperty('margin-right', '0px', 'important');\n    el.style.setProperty('max-width', 'none', 'important');\n    if (COVER_TOP) el.style.setProperty('margin-top', '0px', 'important');\n    el.style.width = '';\n    var vw = document.documentElement.clientWidth;\n    var rect = el.getBoundingClientRect();\n    el.style.width = vw + 'px';\n    el.style.setProperty('margin-left', (-rect.left) + 'px', 'important');\n    if (COVER_TOP) {\n      var bar = document.getElementById('wpadminbar');\n      var barH = bar ? bar.offsetHeight : 0;\n      var topGap = rect.top + window.scrollY - barH;\n      if (topGap > 0) el.style.setProperty('margin-top', (-topGap) + 'px', 'important');\n    }\n    var after = el.getBoundingClientRect().left;\n    if (Math.abs(after) > 1) {\n      el.style.setProperty('margin-left', ((-rect.left) - after) + 'px', 'important');\n    }\n    if (COVER_TOP) {\n      var bar2 = document.getElementById('wpadminbar');\n      var barH2 = bar2 ? bar2.offsetHeight : 0;\n      var topResidual = el.getBoundingClientRect().top + window.scrollY - barH2;\n      if (Math.abs(topResidual) > 1) {\n        var curTop = parseFloat(el.style.marginTop) || 0;\n        el.style.setProperty('margin-top', (curTop - topResidual) + 'px', 'important');\n      }\n    }\n  }\n  fullBleed();\n  window.addEventListener('resize', fullBleed);\n  window.addEventListener('load', fullBleed);\n  setTimeout(fullBleed, 600);\n  setTimeout(fullBleed, 2000);\n\n  /* ── 히어로 배너 자동 찾기 (기존 로직 재사용) ── */\n  try { (function () {\n    var hero = document.querySelector('#ondo-hub-page .hub-hero img');\n    if (!hero) return;\n    var tried = false;\n    function autoHero() {\n      if (tried) return;\n      tried = true;\n      fetch(SITE_API + '/media?media_type=image&per_page=100&orderby=date&order=desc&_fields=source_url,slug,media_details')\n        .then(function (r) { return r.json(); })\n        .then(function (items) {\n          if (!items || !items.length) return;\n          var good = ['hero', 'banner', 'city', 'main', 'header', 'bg', 'insight'];\n          var bad = ['category', 'logo', 'icon', 'favicon', 'profile'];\n          var best = null, bestScore = -1;\n          for (var i = 0; i < items.length; i++) {\n            var it = items[i];\n            var slug = (it.slug || '').toLowerCase();\n            var skip = false;\n            for (var b = 0; b < bad.length; b++) { if (slug.indexOf(bad[b]) !== -1) { skip = true; break; } }\n            if (skip || !it.source_url) continue;\n            var score = 0;\n            for (var g = 0; g < good.length; g++) { if (slug.indexOf(good[g]) !== -1) { score += 4; break; } }\n            var d = it.media_details || {};\n            if (d.width >= 1200) score += 1;\n            if (d.width && d.height && d.width > d.height * 1.6) score += 2;\n            if (score > bestScore) { bestScore = score; best = it; }\n          }\n          if (best && bestScore > 0) {\n            hero.src = best.source_url;\n            hero.style.display = 'block';\n          }\n        })\n        .catch(function () {});\n    }\n    hero.addEventListener('error', autoHero);\n    if (hero.complete && hero.naturalWidth === 0) autoHero();\n    window.addEventListener('load', function () {\n      if (hero.naturalWidth === 0) autoHero();\n    });\n  })(); } catch (e) {}\n\n  /* ── 카테고리 메타 (기존과 동일 — 슬러그는 WP 카테고리 슬러그와 일치해야 함) ── */\n  var CATEGORY_META = {\n    etf:     { label: 'ETF',               image: 'https://ondo99.com/wp-content/uploads/2026/07/ETF-Category.png' },\n    trend:   { label: 'Trend',             image: 'https://ondo99.com/wp-content/uploads/2026/07/Trend-Category-with-tagline.png' },\n    patents: { label: 'Tech & Patents',    image: 'https://ondo99.com/wp-content/uploads/2026/07/Patents-Category.png' },\n    biotech: { label: 'Biotech/New Drugs', image: 'https://ondo99.com/wp-content/uploads/2026/07/Biotech-Category.png' },\n    energy:  { label: 'Energy & Climate',  image: '' },\n    society: { label: 'Society',           image: '' }\n  };\n\n  var categoryIdCache = {};\n  var postCache = {};\n\n  function stripHtml(html) {\n    var div = document.createElement('div');\n    div.innerHTML = html || '';\n    return (div.textContent || div.innerText || '').trim();\n  }\n\n  function getCategoryId(slug) {\n    if (categoryIdCache[slug] !== undefined) return Promise.resolve(categoryIdCache[slug]);\n    return fetch(SITE_API + '/categories?slug=' + encodeURIComponent(slug))\n      .then(function (res) { return res.json(); })\n      .then(function (data) {\n        var id = (data && data.length > 0) ? data[0].id : null;\n        categoryIdCache[slug] = id;\n        return id;\n      })\n      .catch(function () { categoryIdCache[slug] = null; return null; });\n  }\n\n  function fetchLatestPost(slug) {\n    if (postCache[slug] !== undefined) return Promise.resolve(postCache[slug]);\n    return getCategoryId(slug).then(function (catId) {\n      if (!catId) { postCache[slug] = null; return null; }\n      return fetch(SITE_API + '/posts?categories=' + catId + '&per_page=1&orderby=date&order=desc&_embed')\n        .then(function (res) { return res.json(); })\n        .then(function (posts) {\n          var post = (posts && posts.length > 0) ? posts[0] : null;\n          postCache[slug] = post;\n          return post;\n        })\n        .catch(function () { postCache[slug] = null; return null; });\n    });\n  }\n\n  function getThumb(slug, post) {\n    try {\n      var media = post._embedded['wp:featuredmedia'];\n      if (media && media[0] && media[0].source_url) return media[0].source_url;\n    } catch (e) {}\n    return CATEGORY_META[slug] ? CATEGORY_META[slug].image : '';\n  }\n\n  /* ── 카테고리 페이지 링크 자동 조회 (기존 로직 재사용) ── */\n  var CAT_PAGE_LINKS = {};\n  var TAB_TITLE_MAP = {\n    etf: ['etf'],\n    patents: ['patents', 'patent', 'tech & patents'],\n    biotech: ['bio', 'biotech', 'biotech/new drugs'],\n    trend: ['trend'],\n    energy: ['energy', 'energy & climate'],\n    society: ['society']\n  };\n  fetch(SITE_API + '/pages?per_page=100&_fields=link,title')\n    .then(function (r) { return r.json(); })\n    .then(function (pages) {\n      (pages || []).forEach(function (pg) {\n        var t = stripHtml((pg.title && pg.title.rendered) || '').toLowerCase().trim();\n        Object.keys(TAB_TITLE_MAP).forEach(function (slug) {\n          if (!CAT_PAGE_LINKS[slug] && TAB_TITLE_MAP[slug].indexOf(t) !== -1) CAT_PAGE_LINKS[slug] = pg.link;\n        });\n      });\n    })\n    .catch(function () {});\n\n  document.getElementById('hubCards').addEventListener('click', function (e) {\n    var el = e.target;\n    while (el && el !== e.currentTarget) {\n      if (el.getAttribute && el.getAttribute('data-hubcat')) {\n        var slug = el.getAttribute('data-hubcat');\n        var url = CAT_PAGE_LINKS[slug];\n        if (url) {\n          e.preventDefault();\n          window.location.href = url;\n        }\n        return;\n      }\n      el = el.parentNode;\n    }\n  });\n\n  /* ── 카드에 최신글 채우기 ── */\n  Object.keys(CATEGORY_META).forEach(function (slug) {\n    var titleEl = document.querySelector('#ondo-hub-page [data-hubtitle=\"' + slug + '\"]');\n    var imgEl = document.querySelector('#ondo-hub-page [data-hubimg=\"' + slug + '\"]');\n    // 카테고리 기본 이미지 먼저\n    if (imgEl && CATEGORY_META[slug].image) {\n      imgEl.src = CATEGORY_META[slug].image;\n      imgEl.style.display = 'block';\n    } else if (imgEl) {\n      imgEl.style.display = 'none';\n    }\n    fetchLatestPost(slug).then(function (post) {\n      var card = titleEl ? titleEl.closest('.hub-card') : null;\n      if (!post) {\n        if (titleEl) titleEl.textContent = T.comingSoon;\n        if (card) card.classList.add('is-empty');\n        return;\n      }\n      if (titleEl) titleEl.textContent = stripHtml(post.title.rendered);\n      var thumb = getThumb(slug, post);\n      if (imgEl && thumb) {\n        imgEl.src = thumb;\n        imgEl.style.display = 'block';\n      }\n    });\n  });\n\n  /* ══════════ 세계시계 + 거래소 개장 상태 ══════════ */\n  var MARKETS = [\n    { city: KO ? '서울' : 'Seoul',    exch: 'KRX',  tz: 'Asia/Seoul',       open: [9, 0],   close: [15, 30] },\n    { city: KO ? '도쿄' : 'Tokyo',    exch: 'TSE',  tz: 'Asia/Tokyo',       open: [9, 0],   close: [15, 30] },\n    { city: KO ? '런던' : 'London',   exch: 'LSE',  tz: 'Europe/London',    open: [8, 0],   close: [16, 30] },\n    { city: KO ? '뉴욕' : 'New York', exch: 'NYSE', tz: 'America/New_York', open: [9, 30],  close: [16, 0] }\n  ];\n\n  function getPartsInTz(tz) {\n    // 해당 타임존의 현재 시/분/요일을 안전하게 구함\n    var fmt = new Intl.DateTimeFormat('en-US', {\n      timeZone: tz, hour12: false,\n      weekday: 'short', hour: '2-digit', minute: '2-digit', second: '2-digit'\n    });\n    var parts = {};\n    fmt.formatToParts(new Date()).forEach(function (p) { parts[p.type] = p.value; });\n    return {\n      weekday: parts.weekday,\n      hour: parseInt(parts.hour, 10) % 24,\n      minute: parseInt(parts.minute, 10),\n      second: parseInt(parts.second, 10)\n    };\n  }\n\n  function isMarketOpen(m, p) {\n    if (p.weekday === 'Sat' || p.weekday === 'Sun') return false;\n    var now = p.hour * 60 + p.minute;\n    var openMin = m.open[0] * 60 + m.open[1];\n    var closeMin = m.close[0] * 60 + m.close[1];\n    return now >= openMin && now < closeMin;\n  }\n\n  function pad(n) { return (n < 10 ? '0' : '') + n; }\n\n  function renderClocks() {\n    var wrap = document.getElementById('hubClocks');\n    if (!wrap) return;\n    var html = '';\n    for (var i = 0; i < MARKETS.length; i++) {\n      var m = MARKETS[i];\n      var p;\n      try { p = getPartsInTz(m.tz); } catch (e) { continue; }\n      var openNow = isMarketOpen(m, p);\n      html +=\n        '<div class=\"hub-clock-row\">' +\n          '<div class=\"hub-clock-city\">' + m.city + '<small>' + m.exch + '</small></div>' +\n          '<div class=\"hub-clock-time\">' + pad(p.hour) + ':' + pad(p.minute) + ':' + pad(p.second) + '</div>' +\n          '<div class=\"hub-clock-status ' + (openNow ? 'is-open' : 'is-closed') + '\">' + (openNow ? T.open : T.closed) + '</div>' +\n        '</div>';\n    }\n    wrap.innerHTML = html;\n  }\n  renderClocks();\n  setInterval(renderClocks, 1000);\n\n  /* ══════════ 환율 요약 (Frankfurter API — 기존 위젯 로직 재사용) ══════════ */\n  (function loadFx() {\n    var wrap = document.getElementById('hubFx');\n    if (!wrap) return;\n    fetch('https://api.frankfurter.dev/v1/latest?base=USD&symbols=KRW,JPY,EUR,CNY')\n      .then(function (r) { return r.json(); })\n      .then(function (data) {\n        var rates = data.rates || {};\n        if (!rates.KRW) { wrap.innerHTML = '<div class=\"hub-fx-loading\">' + T.fxError + '</div>'; return; }\n        var html = '';\n        html += fxRow('USD / KRW', KO ? '미국 달러' : 'US Dollar', Math.round(rates.KRW).toLocaleString() + (KO ? '원' : ' KRW'));\n        if (rates.JPY) {\n          var jpyKrw = Math.round((rates.KRW / rates.JPY) * 100);\n          html += fxRow('JPY(100) / KRW', KO ? '일본 엔' : 'Japanese Yen', jpyKrw.toLocaleString() + (KO ? '원' : ' KRW'));\n        }\n        if (rates.EUR) {\n          var eurKrw = Math.round(rates.KRW / rates.EUR);\n          html += fxRow('EUR / KRW', KO ? '유로' : 'Euro', eurKrw.toLocaleString() + (KO ? '원' : ' KRW'));\n        }\n        if (rates.CNY) {\n          var cnyKrw = Math.round(rates.KRW / rates.CNY);\n          html += fxRow('CNY / KRW', KO ? '중국 위안' : 'Chinese Yuan', cnyKrw.toLocaleString() + (KO ? '원' : ' KRW'));\n        }\n        wrap.innerHTML = html;\n      })\n      .catch(function () {\n        wrap.innerHTML = '<div class=\"hub-fx-loading\">' + T.fxError + '</div>';\n      });\n\n    function fxRow(pair, name, value) {\n      return (\n        '<div class=\"hub-fx-row\">' +\n          '<div class=\"hub-fx-label\">' + pair + '<small>' + name + '</small></div>' +\n          '<div class=\"hub-fx-val\">' + value + '</div>' +\n        '</div>'\n      );\n    }\n  })();\n})();\n</script>\n<script>\n/* 워드프레스가 저장할 때 코드 속 '그리고' 기호(앰퍼샌드)를 다른 글자로 바꿔버려서 코드가 멈추는 문제가 있다.\n   그래서 실제 코드는 위의 text/plain 상자에 넣어두고, 여기서 원래 기호로 되돌린 뒤 실행한다.\n   (이 실행부에는 일부러 그 기호를 쓰지 않는다) */\n(function () {\n  var box = document.getElementById('ondo-page-code');\n  if (!box) return;\n  var A = String.fromCharCode(38);\n  var code = box.textContent.split(A + '#038;').join(A).split(A + '#38;').join(A);\n  (new Function(code))();\n})();\n</script>\n",
