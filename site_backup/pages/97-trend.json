 "content": "\n<div id=\"ondo-cat-page\">\n<style>\n  #ondo-cat-page {\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Malgun Gothic', sans-serif;\n    background: #0a1322;\n    color: #f4f6fb;\n  }\n  #ondo-cat-page * { box-sizing: border-box; }\n  #ondo-cat-page { word-break: keep-all; overflow-wrap: break-word; }\n  #ondo-cat-page a { text-decoration: none; color: inherit; }\n  #ondo-cat-page .oc-inner { max-width: 1180px; margin: 0 auto; padding: 0 28px; }\n\n  /* ── 상단 바: 로고 + 브레드크럼 + 카테고리 탭 ── */\n  #ondo-cat-page .oc-topbar {\n    position: relative;\n    z-index: 3;\n  }\n  #ondo-cat-page .oc-topbar .oc-inner {\n    display: flex;\n    align-items: center;\n    gap: 26px;\n    flex-wrap: wrap;\n    padding-top: 20px;\n    padding-bottom: 6px;\n  }\n  #ondo-cat-page .oc-logo {\n    font-family: 'Montserrat', -apple-system, sans-serif;\n    font-size: 16px;\n    font-weight: 900;\n    letter-spacing: 1.6px;\n    line-height: 1.25;\n    color: #e8b944;\n  }\n  #ondo-cat-page .oc-crumb {\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 2.4px;\n    color: #cdd6e6;\n  }\n  #ondo-cat-page .oc-crumb b { color: #e8b944; font-weight: 700; }\n  #ondo-cat-page .oc-tabs {\n    display: flex;\n    align-items: center;\n    gap: 24px;\n    flex-wrap: wrap;\n    margin-left: auto;\n  }\n  #ondo-cat-page .oc-tab {\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.4px;\n    text-transform: uppercase;\n    color: #c7d2e6;\n    padding: 6px 2px;\n    border-bottom: 2px solid transparent;\n    transition: color .15s;\n  }\n  #ondo-cat-page .oc-tab:hover { color: #e8b944; }\n  #ondo-cat-page .oc-tab.is-active { color: #ffffff; border-bottom-color: #e8b944; }\n\n  /* ── 히어로: 풀블리드 배경 + 초대형 카테고리 타이틀 ── */\n  #ondo-cat-page .oc-hero {\n    position: relative;\n    margin-top: -64px;           /* 상단 바 뒤로 배경이 이어지게 */\n    padding-top: 64px;\n    overflow: hidden;\n    background: linear-gradient(120deg, #16244a 0%, #0b1428 100%);\n  }\n  #ondo-cat-page .oc-hero-img[src=\"\"] { display: none; }\n  #ondo-cat-page .oc-hero-img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    object-position: center;\n    opacity: 0.55;\n  }\n  #ondo-cat-page .oc-hero-fade {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(180deg, rgba(10,19,34,0.42) 0%, rgba(10,19,34,0.62) 55%, #0a1322 100%);\n  }\n  #ondo-cat-page .oc-hero .oc-inner {\n    position: relative;\n    z-index: 2;\n    width: 100%;\n    padding-top: 54px;\n    padding-bottom: 34px;\n  }\n  /* [시안] 초대형 골드 카테고리명 */\n  #ondo-cat-page .oc-hero-title {\n    font-family: 'Montserrat', -apple-system, sans-serif;\n    font-size: 88px;\n    font-weight: 900;\n    color: #e8b944;\n    letter-spacing: 3px;\n    line-height: 1.0;\n    margin: 0 0 10px;\n    text-transform: uppercase;\n    text-shadow: 0 3px 22px rgba(0,0,0,0.5);\n  }\n  /* [시안] 영문 태그라인 (화이트 대문자) */\n  #ondo-cat-page .oc-hero-tagline {\n    font-size: 15px;\n    font-weight: 800;\n    letter-spacing: 2.2px;\n    text-transform: uppercase;\n    color: #ffffff;\n    margin: 0 0 22px;\n    text-shadow: 0 1px 10px rgba(0,0,0,0.55);\n  }\n  #ondo-cat-page .oc-hero-desc {\n    font-size: 16px;\n    color: #dfe6f2;\n    line-height: 1.7;\n    max-width: 640px;\n    margin: 0 0 26px;\n    text-shadow: 0 1px 8px rgba(0,0,0,0.45);\n  }\n  #ondo-cat-page .oc-hero-desc b { color: #ffffff; font-weight: 700; }\n\n  /* ── [시안] 필터 칩 ── */\n  #ondo-cat-page .oc-chips {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    gap: 12px;\n    flex-wrap: wrap;\n    padding-bottom: 6px;\n  }\n  #ondo-cat-page .oc-chip {\n    display: inline-flex;\n    align-items: center;\n    gap: 7px;\n    font-size: 14px;\n    font-weight: 800;\n    color: #14203a;\n    background: #e8b944;\n    border: 1.5px solid #e8b944;\n    border-radius: 999px;\n    padding: 11px 22px;\n    cursor: pointer;\n    transition: background .15s, color .15s, transform .15s;\n  }\n  #ondo-cat-page .oc-chip:hover { transform: translateY(-1px); }\n  #ondo-cat-page .oc-chip:not(.is-active) {\n    background: transparent;\n    color: #e8b944;\n  }\n  #ondo-cat-page .oc-chip svg { display: block; }\n\n  /* ── 본문 ── */\n  #ondo-cat-page .oc-body { padding-top: 30px; padding-bottom: 26px; }\n\n  /* [시안] 피처드: 가로형 대형 카드 (이미지 좌 / 텍스트 우) */\n  #ondo-cat-page .oc-feat {\n    display: flex;\n    gap: 30px;\n    border: 1px solid rgba(197,209,229,0.28);\n    background: rgba(16,28,52,0.55);\n    border-radius: 18px;\n    padding: 22px;\n    margin-bottom: 26px;\n    position: relative;\n    transition: transform .2s, border-color .2s, box-shadow .2s;\n  }\n  #ondo-cat-page .oc-feat:hover {\n    transform: translateY(-3px);\n    border-color: rgba(232,185,68,0.8);\n    box-shadow: 0 14px 38px rgba(0,0,0,0.4);\n  }\n  #ondo-cat-page .oc-feat-img {\n    width: 44%;\n    min-height: 300px;\n    align-self: stretch;\n    object-fit: cover;\n    border-radius: 12px;\n    flex-shrink: 0;\n    display: block;\n    border: 1px solid rgba(232,185,68,0.5);\n  }\n  #ondo-cat-page .oc-feat-txt {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 12px 64px 12px 4px;\n  }\n  #ondo-cat-page .oc-feat-cat {\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: 2.4px;\n    text-transform: uppercase;\n    color: #e8b944;\n    margin-bottom: 12px;\n  }\n  #ondo-cat-page .oc-feat-title {\n    font-size: 28px;\n    font-weight: 800;\n    color: #ffffff;\n    line-height: 1.38;\n    margin: 0 0 14px;\n  }\n  #ondo-cat-page .oc-meta {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: 1px;\n    color: #c3cee2;\n    margin-bottom: 16px;\n  }\n  #ondo-cat-page .oc-meta .oc-cal {\n    display: inline-flex;\n    width: 17px; height: 17px;\n    border: 1.5px solid #e8b944;\n    border-radius: 3px;\n    position: relative;\n    flex-shrink: 0;\n  }\n  #ondo-cat-page .oc-meta .oc-cal::before {\n    content: '';\n    position: absolute;\n    left: 2px; right: 2px; top: 4px;\n    height: 1.5px;\n    background: #e8b944;\n  }\n  #ondo-cat-page .oc-meta .dot { color: #55648a; margin: 0 2px; }\n  #ondo-cat-page .oc-feat-excerpt {\n    font-size: 15px;\n    color: #b4c0d8;\n    line-height: 1.75;\n    margin: 0;\n  }\n  /* [시안] 골드 원형 화살표 버튼 */\n  #ondo-cat-page .oc-fab {\n    position: absolute;\n    right: 26px;\n    bottom: 26px;\n    width: 46px;\n    height: 46px;\n    border-radius: 50%;\n    background: #e8b944;\n    color: #14203a;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 20px;\n    font-weight: 700;\n    transition: transform .18s;\n  }\n  #ondo-cat-page .oc-feat:hover .oc-fab,\n  #ondo-cat-page .oc-card:hover .oc-fab { transform: translateX(4px); }\n\n  /* [시안] 2단 카드 그리드 */\n  #ondo-cat-page .oc-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 26px;\n  }\n  #ondo-cat-page .oc-card {\n    display: flex;\n    gap: 22px;\n    border: 1px solid rgba(197,209,229,0.28);\n    background: rgba(16,28,52,0.55);\n    border-radius: 18px;\n    padding: 20px;\n    position: relative;\n    transition: transform .2s, border-color .2s, box-shadow .2s;\n  }\n  #ondo-cat-page .oc-card:hover {\n    transform: translateY(-3px);\n    border-color: rgba(232,185,68,0.8);\n    box-shadow: 0 12px 32px rgba(0,0,0,0.4);\n  }\n  #ondo-cat-page .oc-card-img {\n    width: 170px;\n    align-self: stretch;\n    min-height: 210px;\n    object-fit: cover;\n    border-radius: 12px;\n    flex-shrink: 0;\n    display: block;\n    border: 1px solid rgba(255,255,255,0.12);\n  }\n  #ondo-cat-page .oc-card-txt {\n    flex: 1;\n    min-width: 0;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 6px 6px 40px 0;\n  }\n  #ondo-cat-page .oc-card-cat {\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: #e8b944;\n    margin-bottom: 10px;\n  }\n  #ondo-cat-page .oc-card-title {\n    font-size: 20px;\n    font-weight: 800;\n    color: #ffffff;\n    line-height: 1.42;\n    margin: 0 0 12px;\n  }\n  #ondo-cat-page .oc-card .oc-meta { margin-bottom: 0; }\n  #ondo-cat-page .oc-card .oc-fab { right: 20px; bottom: 20px; width: 42px; height: 42px; font-size: 18px; }\n\n  /* 빈 상태 */\n  #ondo-cat-page .oc-empty {\n    border: 1px dashed rgba(232,185,68,0.5);\n    border-radius: 18px;\n    text-align: center;\n    padding: 70px 24px;\n    margin-bottom: 26px;\n  }\n  #ondo-cat-page .oc-empty-title {\n    font-size: 22px;\n    font-weight: 800;\n    color: #e8b944;\n    margin: 0 0 10px;\n  }\n  #ondo-cat-page .oc-empty-desc {\n    font-size: 14px;\n    color: #9fabc6;\n    margin: 0;\n  }\n\n  /* [시안] 페이지네이션 */\n  #ondo-cat-page .oc-pager {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    padding: 38px 0 10px;\n  }\n  #ondo-cat-page .oc-page {\n    width: 44px;\n    height: 44px;\n    border-radius: 50%;\n    border: 1px solid rgba(197,209,229,0.4);\n    color: #dfe6f2;\n    font-size: 15px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    background: transparent;\n    transition: border-color .15s, background .15s, color .15s;\n  }\n  #ondo-cat-page .oc-page:hover { border-color: #e8b944; color: #e8b944; }\n  #ondo-cat-page .oc-page.is-active {\n    background: #e8b944;\n    border-color: #e8b944;\n    color: #14203a;\n  }\n  #ondo-cat-page .oc-page.is-disabled { opacity: 0.35; pointer-events: none; }\n\n  #ondo-cat-page .oc-loading {\n    padding: 70px 0;\n    text-align: center;\n    color: #8fa0be;\n    font-size: 14px;\n  }\n\n  /* ── 푸터 ── */\n  #ondo-cat-page .oc-footer {\n    background: #081020;\n    border-top: 1px solid rgba(255,255,255,0.07);\n    margin-top: 40px;\n    padding: 48px 0 30px;\n  }\n  #ondo-cat-page .oc-footer-cols { display: flex; gap: 48px; flex-wrap: wrap; }\n  #ondo-cat-page .oc-footer-brand {\n    font-family: 'Montserrat', -apple-system, sans-serif;\n    font-size: 22px;\n    font-weight: 900;\n    letter-spacing: 1.6px;\n    color: #e8b944;\n    line-height: 1.3;\n  }\n  #ondo-cat-page .oc-footer h4 {\n    font-size: 12px;\n    font-weight: 800;\n    letter-spacing: 2.4px;\n    color: #ffffff;\n    margin: 0 0 12px;\n  }\n  #ondo-cat-page .oc-footer p {\n    font-size: 13px;\n    color: #98a3b8;\n    line-height: 1.9;\n    margin: 0;\n  }\n  #ondo-cat-page .oc-copy {\n    text-align: center;\n    font-size: 12px;\n    letter-spacing: 1.4px;\n    color: #66738c;\n    padding-top: 34px;\n  }\n\n  /* ── 반응형 ── */\n  @media (max-width: 920px) {\n    #ondo-cat-page .oc-inner { padding: 0 18px; }\n    #ondo-cat-page .oc-tabs { margin-left: 0; gap: 14px; }\n    #ondo-cat-page .oc-tab { font-size: 11px; }\n    #ondo-cat-page .oc-hero-title { font-size: 52px; }\n    #ondo-cat-page .oc-hero-tagline { font-size: 12px; letter-spacing: 1.6px; }\n    #ondo-cat-page .oc-hero-desc { font-size: 14px; }\n    #ondo-cat-page .oc-chip { font-size: 13px; padding: 9px 16px; }\n    #ondo-cat-page .oc-feat { flex-direction: column; gap: 18px; padding: 16px; }\n    #ondo-cat-page .oc-feat-img { width: 100%; min-height: 0; aspect-ratio: 16/9; }\n    #ondo-cat-page .oc-feat-txt { padding: 0 0 46px; }\n    #ondo-cat-page .oc-feat-title { font-size: 21px; }\n    #ondo-cat-page .oc-grid { grid-template-columns: 1fr; gap: 18px; }\n    #ondo-cat-page .oc-card-img { width: 120px; min-height: 150px; }\n    #ondo-cat-page .oc-card-title { font-size: 16px; }\n    #ondo-cat-page .oc-page { width: 38px; height: 38px; font-size: 13px; }\n    #ondo-cat-page .oc-footer-cols { gap: 26px; }\n  }\n</style>\n\n  <!-- 상단 바 -->\n  <div class=\"oc-topbar\">\n    <div class=\"oc-inner\">\n      <a class=\"oc-logo\" href=\"/\">DATA-DRIVEN<br>INSIGHTS</a>\n      <div class=\"oc-crumb\">INSIGHTS / <b id=\"oc-crumb-cat\"></b></div>\n      <div class=\"oc-tabs\" id=\"oc-tabs\"></div>\n    </div>\n  </div>\n\n  <!-- 히어로 -->\n  <div class=\"oc-hero\">\n    <!-- ★★★ 배경 사진을 직접 지정하려면 아래 src에 이미지 URL을 넣으세요.\n         비워두면 미디어 라이브러리에서 자동으로 찾습니다. ★★★ -->\n    <img decoding=\"async\" class=\"oc-hero-img\" id=\"oc-hero-img\" src=\"\" alt=\"\" />\n    <div class=\"oc-hero-fade\"></div>\n    <div class=\"oc-inner\">\n      <h1 class=\"oc-hero-title\" id=\"oc-hero-title\"></h1>\n      <div class=\"oc-hero-tagline\" id=\"oc-hero-tagline\"></div>\n      <p class=\"oc-hero-desc\" id=\"oc-hero-desc\"></p>\n      <div class=\"oc-chips\" id=\"oc-chips\"></div>\n    </div>\n  </div>\n\n  <!-- 본문 -->\n  <div class=\"oc-inner\">\n    <div class=\"oc-body\">\n      <div id=\"oc-list\">\n        <div class=\"oc-loading\">불러오는 중&#8230;</div>\n      </div>\n      <div class=\"oc-pager\" id=\"oc-pager\" style=\"display:none;\"></div>\n    </div>\n  </div>\n\n  <!-- 푸터 -->\n  <div class=\"oc-footer\">\n    <div class=\"oc-inner\">\n      <div class=\"oc-footer-cols\">\n        <div style=\"flex:1.2;min-width:200px;\">\n          <div class=\"oc-footer-brand\">DATA-DRIVEN<br>INSIGHTS</div>\n        </div>\n        <div style=\"flex:1;min-width:180px;\">\n          <h4>ABOUT</h4>\n          <p>데이터 기반 인사이트로<br>투자 경험을 지원하는<br>프리미엄 정보 플랫폼입니다.</p>\n        </div>\n        <div style=\"flex:1;min-width:150px;\">\n          <h4>LEGAL</h4>\n          <p>이용약관<br>개인정보처리방침<br>저작권 안내</p>\n        </div>\n        <div style=\"flex:1;min-width:200px;\">\n          <h4>CONTACT</h4>\n          <p>제휴 및 광고 문의<br>파트너십 문의</p>\n        </div>\n      </div>\n      <div class=\"oc-copy\">&copy; 2026 DATA-DRIVEN INSIGHTS. ALL RIGHTS RESERVED.</div>\n    </div>\n  </div>\n</div>\n\n<script type=\"text/plain\" id=\"ondo-page-code\">\n(function () {\n  var SITE_API = 'https://ondo99.com/wp-json/wp/v2';\n\n  /* ── 브라우저 언어 감지: 한국어면 한국어 문구, 그 외에는 영어 문구 ── */\n  var KO = ((navigator.language || navigator.userLanguage || '') + '').toLowerCase().indexOf('ko') === 0;\n  var T = KO ? {\n    loading: '불러오는 중...',\n    comingSoonTitle: '곧 공개됩니다',\n    comingSoonDesc: '이 카테고리의 첫 글을 준비하고 있습니다. 조금만 기다려주세요.',\n    noTagPosts: '이 주제의 글이 아직 없습니다. 다른 필터를 눌러보세요.',\n    loadError: '글을 불러오지 못했습니다. 페이지를 새로고침 해보세요.',\n    minRead: '분 읽기',\n    all: 'ALL'\n  } : {\n    loading: 'Loading...',\n    comingSoonTitle: 'Coming Soon',\n    comingSoonDesc: 'The first article in this category is on its way. Stay tuned.',\n    noTagPosts: 'No articles on this topic yet. Try another filter.',\n    loadError: 'Could not load articles. Please refresh the page.',\n    minRead: ' min read',\n    all: 'ALL'\n  };\n  document.querySelectorAll('#ondo-cat-page .oc-loading').forEach(function (n) { n.textContent = T.loading; });\n\n  /* ★★★ 이 페이지의 카테고리: 'etf' | 'trend' | 'patents' | 'biotech' | 'energy' | 'society' 중 하나로 바꾸세요 ★★★ */\n  var CATEGORY = 'trend';\n\n  /* 카테고리별 설정: 라벨, 영문 태그라인, 소개 문구, 대체 이미지, 필터 칩.\n     chips의 각 항목은 {label: 화면에 보일 이름, tag: 워드프레스 태그 검색어} 입니다.\n     글에 그 태그가 없으면 \"글이 아직 없습니다\"로 표시되므로, 실제 쓰는 태그에 맞게 수정하세요. */\n  var CATEGORY_META = {\n    etf: {\n      label: 'ETF',\n      tagline: 'Diversified. Transparent. Growth-Focused.',\n      desc: '<b>ETF</b> 투자 전략과 시장 흐름을 데이터로 풀어냅니다.',\n      desc_en: '<b>ETF</b> strategies and market currents, decoded with data.',\n      image: 'https://ondo99.com/wp-content/uploads/2026/07/ETF-Category.png',\n      chips: [\n        { label: KO ? '미국 ETF' : 'US ETF', tag: '미국' },\n        { label: KO ? '배당' : 'Dividend', tag: '배당' },\n        { label: KO ? '섹터' : 'Sector', tag: '섹터' },\n        { label: KO ? '환율' : 'FX', tag: '환율' }\n      ]\n    },\n    trend: {\n      label: 'Trend',\n      tagline: 'What People Are Talking About.',\n      desc: '요즘 사람들이 무엇에 관심을 갖는지, 검색 데이터로 트렌드를 읽습니다.',\n      desc_en: 'What people care about right now, read through search data.',\n      image: 'https://ondo99.com/wp-content/uploads/2026/07/Trend-Category-with-tagline.png',\n      chips: []\n    },\n    patents: {\n      label: 'Tech & Patents',\n      tagline: 'Ideas That Shape Tomorrow.',\n      desc: 'AI·우주·로봇 같은 신기술과 특허 흐름으로 미래 산업을 살펴봅니다.',\n      desc_en: 'New technologies such as AI, space and robotics, and the patents behind them.',\n      image: 'https://ondo99.com/wp-content/uploads/2026/07/Patents-Category.png',\n      chips: []\n    },\n    biotech: {\n      label: 'Biotech/New Drugs',\n      tagline: 'Innovation. Discovery. Transformation.',\n      desc: '신약 승인과 임상 결과처럼 확인된 사실을 중심으로 바이오 소식을 정리합니다.',\n      desc_en: 'Biotech news grounded in confirmed facts such as approvals and trial results.',\n      image: 'https://ondo99.com/wp-content/uploads/2026/07/Biotech-Category.png',\n      chips: []\n    },\n    energy: {\n      label: 'Energy & Climate',\n      tagline: 'Power. Resources. Planet.',\n      desc: '전력·자원·식량·기후 변화를 공식 데이터로 풀어봅니다.',\n      desc_en: 'Power, resources, food and climate, explained with official data.',\n      image: '',\n      chips: []\n    },\n    society: {\n      label: 'Society',\n      tagline: 'How We Live Is Changing.',\n      desc: '인구와 사회의 변화를 통계로 읽습니다.',\n      desc_en: 'Population and social change, read through statistics.',\n      image: '',\n      chips: []\n    }\n  };\n\n  /* 탭/버튼이 이동할 주소. 카테고리 전용 페이지를 만들었다면 그 페이지 주소로 바꾸세요. */\n  var PAGE_LINKS = {\n    etf: '/category/etf/',\n    patents: '/category/patents/',\n    biotech: '/category/biotech/',\n    trend: '/category/trend/',\n    energy: '/category/energy/',\n    society: '/category/society/'\n  };\n\n  /* 한 페이지에 보여줄 글 수: 피처드 1 + 그리드 4 */\n  var PER_PAGE = 5;\n\n  /* ── 테마 폭 제한 탈출 + 상단 헤더/여백까지 덮기 (잘 작동하는 검증된 코드) ── */\n  var COVER_TOP = true;\n\n  function fullBleed() {\n    var el = document.getElementById('ondo-cat-page');\n    if (!el) return;\n    el.style.position = 'relative';\n    el.style.zIndex = '10';\n    el.style.setProperty('margin-left', '0px', 'important');\n    el.style.setProperty('margin-right', '0px', 'important');\n    el.style.setProperty('max-width', 'none', 'important');\n    if (COVER_TOP) el.style.setProperty('margin-top', '0px', 'important');\n    el.style.width = '';\n    var vw = document.documentElement.clientWidth;\n    var rect = el.getBoundingClientRect();\n    el.style.width = vw + 'px';\n    el.style.setProperty('margin-left', (-rect.left) + 'px', 'important');\n    if (COVER_TOP) {\n      var bar = document.getElementById('wpadminbar');\n      var barH = bar ? bar.offsetHeight : 0;\n      var topGap = rect.top + window.scrollY - barH;\n      if (topGap > 0) el.style.setProperty('margin-top', (-topGap) + 'px', 'important');\n    }\n    var after = el.getBoundingClientRect().left;\n    if (Math.abs(after) > 1) {\n      el.style.setProperty('margin-left', ((-rect.left) - after) + 'px', 'important');\n    }\n    if (COVER_TOP) {\n      var bar2 = document.getElementById('wpadminbar');\n      var barH2 = bar2 ? bar2.offsetHeight : 0;\n      var topResidual = el.getBoundingClientRect().top + window.scrollY - barH2;\n      if (Math.abs(topResidual) > 1) {\n        var curTop = parseFloat(el.style.marginTop) || 0;\n        el.style.setProperty('margin-top', (curTop - topResidual) + 'px', 'important');\n      }\n    }\n    // 아래쪽: 위젯과 테마 푸터 사이의 흰 여백도 덮기\n    var footer = document.querySelector('footer');\n    if (footer && !el.contains(footer) && !footer.contains(el)) {\n      el.style.setProperty('margin-bottom', '0px', 'important');\n      var botGap = footer.getBoundingClientRect().top - el.getBoundingClientRect().bottom;\n      if (botGap > 0) el.style.setProperty('margin-bottom', (-botGap) + 'px', 'important');\n    }\n  }\n  fullBleed();\n  window.addEventListener('resize', fullBleed);\n  window.addEventListener('load', fullBleed);\n  setTimeout(fullBleed, 600);\n  setTimeout(fullBleed, 2000);\n\n  /* ── 유틸 ── */\n  function escapeHtml(str) {\n    var div = document.createElement('div');\n    div.textContent = str || '';\n    return div.innerHTML;\n  }\n  function stripHtml(html) {\n    var div = document.createElement('div');\n    div.innerHTML = html || '';\n    return (div.textContent || div.innerText || '').trim();\n  }\n  function pad2(n) { return (n < 10 ? '0' : '') + n; }\n  function formatDate(iso) {\n    try {\n      var d = new Date(iso);\n      return d.getFullYear() + '.' + pad2(d.getMonth() + 1) + '.' + pad2(d.getDate());\n    } catch (e) { return ''; }\n  }\n  function getThumb(post, fallback) {\n    try {\n      var media = post._embedded['wp:featuredmedia'];\n      if (media &#038;&#038; media[0] &#038;&#038; media[0].source_url) return media[0].source_url;\n    } catch (e) {}\n    // 대표 이미지도 카테고리 기본 이미지도 없으면 투명 이미지로 채워 깨진 그림 표시를 막는다.\n    return fallback || 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';\n  }\n  /* 글별 소제목 라벨: 첫 번째 태그 이름을 쓰고, 없으면 카테고리 라벨 */\n  function getPostLabel(post) {\n    try {\n      var groups = post._embedded['wp:term'] || [];\n      for (var i = 0; i < groups.length; i++) {\n        for (var j = 0; j < groups[i].length; j++) {\n          if (groups[i][j].taxonomy === 'post_tag' &#038;&#038; groups[i][j].name) return groups[i][j].name;\n        }\n      }\n    } catch (e) {}\n    return meta.label;\n  }\n  /* 읽기 시간: 본문 글자수 기준 대략 계산 (한국어 분당 ~600자) */\n  function readMinutes(post) {\n    try {\n      var chars = stripHtml(post.content &#038;&#038; post.content.rendered ? post.content.rendered : '').length;\n      return Math.max(2, Math.round(chars / 600));\n    } catch (e) { return 3; }\n  }\n  function metaLine(post) {\n    return '<span class=\"oc-meta\"><span class=\"oc-cal\"></span>' + escapeHtml(formatDate(post.date)) +\n      '<span class=\"dot\">&middot;</span>' + readMinutes(post) + T.minRead + '</span>';\n  }\n\n  var meta = CATEGORY_META[CATEGORY] || CATEGORY_META.etf;\n\n  /* ── 상단 바 + 히어로 텍스트 ── */\n  (function () {\n    document.getElementById('oc-crumb-cat').textContent = meta.label.toUpperCase();\n    document.getElementById('oc-hero-title').textContent = meta.label;\n    document.getElementById('oc-hero-tagline').textContent = meta.tagline;\n    document.getElementById('oc-hero-desc').innerHTML = KO ? meta.desc : (meta.desc_en || meta.desc);\n    var order = ['etf', 'trend', 'patents', 'biotech', 'energy', 'society'];\n    // 탭은 6개라 짧은 이름을 쓴다(긴 이름은 히어로 제목에만 표시).\n    var TAB_LABELS = { etf: 'ETF', trend: 'Trend', patents: 'Tech', biotech: 'Biotech', energy: 'Energy', society: 'Society' };\n    var html = '';\n    order.forEach(function (slug) {\n      var cls = 'oc-tab' + (slug === CATEGORY ? ' is-active' : '');\n      html += '<a class=\"' + cls + '\" data-slug=\"' + slug + '\" href=\"' + PAGE_LINKS[slug] + '\">' + escapeHtml(TAB_LABELS[slug]) + '</a>';\n    });\n    document.getElementById('oc-tabs').innerHTML = html;\n  })();\n\n  /* ── 탭 링크 자동 연결: 사이트의 실제 페이지(제목: ETF/PATENTS/BIO/TREND 등)를 찾아 탭에 연결 ── */\n  try {\n    var TAB_TITLE_MAP = {\n      etf: ['etf'],\n      patents: ['patents', 'patent', 'tech & patents', 'tech'],\n      biotech: ['bio', 'biotech', 'biotech/new drugs'],\n      trend: ['trend'],\n      energy: ['energy', 'energy & climate'],\n      society: ['society']\n    };\n    fetch(SITE_API + '/pages?per_page=100&_fields=link,title')\n      .then(function (r) { return r.json(); })\n      .then(function (pages) {\n        if (!pages || !pages.length) return;\n        var found = {};\n        pages.forEach(function (pg) {\n          var t = stripHtml(pg.title && pg.title.rendered ? pg.title.rendered : '').toLowerCase().trim();\n          Object.keys(TAB_TITLE_MAP).forEach(function (slug) {\n            if (!found[slug] && TAB_TITLE_MAP[slug].indexOf(t) !== -1) found[slug] = pg.link;\n          });\n        });\n        document.querySelectorAll('#oc-tabs .oc-tab').forEach(function (a) {\n          var slug = a.getAttribute('data-slug');\n          if (found[slug]) a.setAttribute('href', found[slug]);\n        });\n      })\n      .catch(function () {});\n  } catch (e) {}\n\n  /* ── 히어로 배경 자동 찾기 (허브 페이지와 동일 로직) ── */\n  try { (function () {\n    var hero = document.getElementById('oc-hero-img');\n    if (!hero) return;\n    if (hero.getAttribute('src')) return; // 직접 지정했으면 그대로 사용\n    fetch(SITE_API + '/media?media_type=image&per_page=100&orderby=date&order=desc&_fields=source_url,slug,media_details')\n      .then(function (r) { return r.json(); })\n      .then(function (items) {\n        if (!items || !items.length) return;\n        var good = ['hero', 'banner', 'city', 'main', 'header', 'bg', 'insight'];\n        var bad = ['category', 'logo', 'icon', 'favicon', 'profile'];\n        var best = null, bestScore = -1;\n        for (var i = 0; i < items.length; i++) {\n          var it = items[i];\n          var slug = (it.slug || '').toLowerCase();\n          var skip = false;\n          for (var b = 0; b < bad.length; b++) { if (slug.indexOf(bad[b]) !== -1) { skip = true; break; } }\n          if (skip || !it.source_url) continue;\n          var score = 0;\n          for (var g = 0; g < good.length; g++) { if (slug.indexOf(good[g]) !== -1) { score += 4; break; } }\n          var d = it.media_details || {};\n          if (d.width >= 1200) score += 1;\n          if (d.width && d.height && d.width > d.height * 1.6) score += 2;\n          if (score > bestScore) { bestScore = score; best = it; }\n        }\n        if (best && bestScore > 0) hero.src = best.source_url;\n      })\n      .catch(function () {});\n  })(); } catch (e) {}\n\n  /* ── 필터 칩 렌더 ── */\n  var activeChip = null; // null = ALL\n  (function () {\n    var wrap = document.getElementById('oc-chips');\n    var chips = meta.chips || [];\n    var html =\n      '<span class=\"oc-chip is-active\" data-tag=\"\">' +\n        '<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\">' +\n          '<path d=\"M22 3H2l8 9.46V19l4 2v-8.54L22 3z\"/></svg>' +\n        T.all + '</span>';\n    chips.forEach(function (c) {\n      html += '<span class=\"oc-chip\" data-tag=\"' + escapeHtml(c.tag) + '\">' + escapeHtml(c.label) + '</span>';\n    });\n    wrap.innerHTML = html;\n    if (!chips.length) wrap.style.display = 'none';\n    wrap.addEventListener('click', function (e) {\n      var chip = e.target.closest ? e.target.closest('.oc-chip') : null;\n      if (!chip) return;\n      wrap.querySelectorAll('.oc-chip').forEach(function (c) { c.classList.remove('is-active'); });\n      chip.classList.add('is-active');\n      activeChip = chip.getAttribute('data-tag') || null;\n      loadPosts(1);\n    });\n  })();\n\n  /* ── 글 목록 렌더 ── */\n  function renderList(posts) {\n    var wrap = document.getElementById('oc-list');\n    if (!posts.length) {\n      var isFiltered = !!activeChip;\n      wrap.innerHTML =\n        '<div class=\"oc-empty\">' +\n          '<div class=\"oc-empty-title\">' + T.comingSoonTitle + '</div>' +\n          '<div class=\"oc-empty-desc\">' + (isFiltered ? T.noTagPosts : T.comingSoonDesc) + '</div>' +\n        '</div>';\n      return;\n    }\n    var featured = posts[0];\n    var rest = posts.slice(1);\n    var title = stripHtml(featured.title.rendered);\n    var excerpt = stripHtml(featured.excerpt.rendered);\n    if (excerpt.length > 160) excerpt = excerpt.slice(0, 160) + '...';\n    var html =\n      '<a class=\"oc-feat\" href=\"' + featured.link + '\">' +\n        '<img decoding=\"async\" class=\"oc-feat-img\" src=\"' + getThumb(featured, meta.image) + '\" alt=\"' + escapeHtml(title) + '\" />' +\n        '<div class=\"oc-feat-txt\">' +\n          '<div class=\"oc-feat-cat\">' + escapeHtml(getPostLabel(featured)) + '</div>' +\n          '<h2 class=\"oc-feat-title\">' + escapeHtml(title) + '</h2>' +\n          metaLine(featured) +\n          '<p class=\"oc-feat-excerpt\">' + escapeHtml(excerpt) + '</p>' +\n        '</div>' +\n        '<span class=\"oc-fab\">&#8594;</span>' +\n      '</a>';\n    if (rest.length) {\n      html += '<div class=\"oc-grid\">';\n      rest.forEach(function (post) {\n        var t = stripHtml(post.title.rendered);\n        html +=\n          '<a class=\"oc-card\" href=\"' + post.link + '\">' +\n            '<img decoding=\"async\" class=\"oc-card-img\" src=\"' + getThumb(post, meta.image) + '\" alt=\"' + escapeHtml(t) + '\" />' +\n            '<div class=\"oc-card-txt\">' +\n              '<div class=\"oc-card-cat\">' + escapeHtml(getPostLabel(post)) + '</div>' +\n              '<div class=\"oc-card-title\">' + escapeHtml(t) + '</div>' +\n              metaLine(post) +\n            '</div>' +\n            '<span class=\"oc-fab\">&#8594;</span>' +\n          '</a>';\n      });\n      html += '</div>';\n    }\n    wrap.innerHTML = html;\n  }\n\n  /* ── 페이지네이션 렌더 ── */\n  function renderPager(current, total) {\n    var pager = document.getElementById('oc-pager');\n    if (total <= 1) { pager.style.display = 'none'; return; }\n    pager.style.display = 'flex';\n    var html = '';\n    html += '<span class=\"oc-page' + (current <= 1 ? ' is-disabled' : '') + '\" data-page=\"' + (current - 1) + '\">&#8249;</span>';\n    var start = Math.max(1, Math.min(current - 2, total - 4));\n    var end = Math.min(total, start + 4);\n    for (var p = start; p <= end; p++) {\n      html += '<span class=\"oc-page' + (p === current ? ' is-active' : '') + '\" data-page=\"' + p + '\">' + p + '</span>';\n    }\n    html += '<span class=\"oc-page' + (current >= total ? ' is-disabled' : '') + '\" data-page=\"' + (current + 1) + '\">&#8250;</span>';\n    pager.innerHTML = html;\n  }\n  document.getElementById('oc-pager').addEventListener('click', function (e) {\n    var btn = e.target.closest ? e.target.closest('.oc-page') : null;\n    if (!btn || btn.classList.contains('is-disabled') || btn.classList.contains('is-active')) return;\n    var p = parseInt(btn.getAttribute('data-page'), 10);\n    if (p >= 1) {\n      loadPosts(p);\n      var body = document.querySelector('#ondo-cat-page .oc-body');\n      if (body) body.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n  });\n\n  /* ── 데이터 로딩 ── */\n  var categoryIdCache;\n  var tagIdCache = {};\n\n  function getCategoryId() {\n    if (categoryIdCache !== undefined) return Promise.resolve(categoryIdCache);\n    return fetch(SITE_API + '/categories?slug=' + encodeURIComponent(CATEGORY))\n      .then(function (res) { return res.json(); })\n      .then(function (data) {\n        categoryIdCache = (data && data.length > 0) ? data[0].id : null;\n        return categoryIdCache;\n      })\n      .catch(function () { categoryIdCache = null; return null; });\n  }\n  function getTagId(search) {\n    if (tagIdCache[search] !== undefined) return Promise.resolve(tagIdCache[search]);\n    return fetch(SITE_API + '/tags?search=' + encodeURIComponent(search) + '&_fields=id,name&per_page=1')\n      .then(function (res) { return res.json(); })\n      .then(function (data) {\n        tagIdCache[search] = (data && data.length > 0) ? data[0].id : null;\n        return tagIdCache[search];\n      })\n      .catch(function () { tagIdCache[search] = null; return null; });\n  }\n\n  function loadPosts(page) {\n    var wrap = document.getElementById('oc-list');\n    wrap.innerHTML = '<div class=\"oc-loading\">' + T.loading + '</div>';\n    getCategoryId().then(function (catId) {\n      if (!catId) { renderList([]); renderPager(1, 1); return; }\n      var tagPromise = activeChip ? getTagId(activeChip) : Promise.resolve(null);\n      tagPromise.then(function (tagId) {\n        if (activeChip && !tagId) { renderList([]); renderPager(1, 1); return; }\n        var url = SITE_API + '/posts?categories=' + catId +\n          (tagId ? '&tags=' + tagId : '') +\n          '&per_page=' + PER_PAGE + '&page=' + page + '&orderby=date&order=desc&_embed';\n        fetch(url)\n          .then(function (res) {\n            var total = parseInt(res.headers.get('X-WP-TotalPages') || '1', 10);\n            return res.json().then(function (posts) { return { posts: posts || [], total: total }; });\n          })\n          .then(function (r) {\n            renderList(Array.isArray(r.posts) ? r.posts : []);\n            renderPager(page, r.total);\n          })\n          .catch(function () {\n            wrap.innerHTML = '<div class=\"oc-loading\">' + T.loadError + '</div>';\n          });\n      });\n    });\n  }\n\n  loadPosts(1);\n\n  // 10초 후에도 로딩 중이면 안내 문구로 교체\n  setTimeout(function () {\n    var box = document.getElementById('oc-list');\n    if (box && box.querySelector('.oc-loading') && box.querySelector('.oc-loading').textContent === T.loading) {\n      box.innerHTML = '<div class=\"oc-loading\">' + T.loadError + '</div>';\n    }\n  }, 10000);\n})();\n</script>\n<script>\n/* 워드프레스가 저장할 때 코드 속 '그리고' 기호(앰퍼샌드)를 다른 글자로 바꿔버려서 코드가 멈추는 문제가 있다.\n   그래서 실제 코드는 위의 text/plain 상자에 넣어두고, 여기서 원래 기호로 되돌린 뒤 실행한다.\n   (이 실행부에는 일부러 그 기호를 쓰지 않는다) */\n(function () {\n  var box = document.getElementById('ondo-page-code');\n  if (!box) return;\n  var A = String.fromCharCode(38);\n  var code = box.textContent.split(A + '#038;').join(A).split(A + '#38;').join(A);\n  (new Function(code))();\n})();\n</script>\n",
