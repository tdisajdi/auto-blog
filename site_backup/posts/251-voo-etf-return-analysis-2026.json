 \"Vanguard S&P 500 ETF (VOO) - 월봉\", \"yaxis\": {\"title\": \"가격 (₩)\"}, \"xaxis\": {\"title\": \"날짜\", \"type\": \"category\", \"rangeslider\": {\"visible\": false}, \"nticks\": 8, \"tickangle\": 0}, \"template\": \"plotly_white\", \"hovermode\": \"x unified\", \"height\": 450, \"margin\": {\"t\": 60, \"b\": 45, \"l\": 50, \"r\": 20}};    var config = {responsive: true, displaylogo: false};    Plotly.newPlot(gd, data, layout, config);    var btn_m = document.getElementById(\"btn_m_VOO\");    var btn_w = document.getElementById(\"btn_w_VOO\");    if(btn_m) btn_m.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [true, false]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 월봉\"}); });    if(btn_w) btn_w.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [false, true]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 주봉\"}); });  }  if(window.Plotly) initPlotly_VOO();  else if(!document.getElementById(\"plotly_script_VOO\")) {    var s = document.createElement(\"script\");    s.id = \"plotly_script_VOO\";    s.src = \"https://cdn.plot.ly/plotly-2.34.0.min.js\";    s.onload = initPlotly_VOO;    document.head.appendChild(s);  } else {    document.getElementById(\"plotly_script_VOO\").addEventListener(\"load\", initPlotly_VOO);  }})();</script></div>\n<p></div>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<h3 id=\"분기-배당의-흐름과-최근-변화\">분기 배당의 흐름과 최근 변화</h3>\n<p>VOO는 1년에 네 번 분배금(ETF가 투자자에게 나눠 주는 돈)을 지급하는 분기 배당 구조를 갖고 있습니다. 최근 1년 배당금을 현재 가격으로 나눈 최근 배당수익률은 1.08%입니다. 최근 1년 동안 지급된 분기별 배당금을 살펴보면 지급액의 변동성을 확인할 수 있습니다.</p>\n<p>2025년 12월 22일 지급액은 1.7710달러로 직전 대비 +1.78% 증가했고, 2026년 3월 27일에는 1.8720달러로 +5.70%, 2026년 6월 26일에는 1.9620달러로 +4.81% 늘었습니다. 하지만 2026년 9월 28일 지급액은 1.8230달러로 직전 회차보다 -7.08% 감소했습니다. 즉, 최근 4회 지급 내역 중 1회는 배당 지급액이 직전 회차보다 줄어들었습니다.</p>\n<p>이러한 분기별 변동에도 불구하고 장기 흐름을 나타내는 숫자는 성장세를 보이고 있습니다. 가장 최근 지급된 2026년 9월 28일의 1.8230달러는 1년 전 같은 시기인 2025년 9월 29일의 1.7400달러와 비교했을 때 +4.77% 증가한 수치입니다. 최근 20회 지급 내역 전체를 보면 직전 회차보다 줄어든 적이 8회 존재하지만, 그전 1년 합계 대비 최근 1년 배당 합계 증가율은 5.57%를 기록했습니다.</p>\n<p>배당 흐름을 해석할 때는 직전 분기 대비 단순 감소에 민감하게 반응하기보다, 1년 전 같은 기간과의 비교 수치나 연간 합계 증가율을 함께 확인하여 전체적인 분배금 추세를 읽어내는 것이 올바른 접근입니다.</p>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<div id=\"ondo-slot-1\" class=\"ondo-slot\"></div>\n<h3 id=\"비용-환율-및-세금-구조의-모든-것\">비용, 환율 및 세금 구조의 모든 것</h3>\n<p>VOO의 연 운용보수(ETF 운용사가 매년 자산에서 떼어 가는 비용)는 0.03%로 매우 낮게 설정되어 있습니다. 운용보수가 0.1%p(퍼센트포인트, 비율끼리 뺀 차이) 더 높은 타 ETF와 비교할 경우, 1억 원을 10년 동안 투자했을 때 보수 차이로 발생하는 금액은 약 992,826원 수준입니다.</p>\n<p>해외 시장에 상장된 ETF이므로 원/달러 환율 1,334.58원의 영향을 직접 받는 환노출(환율 변화가 수익률에 그대로 반영되는 것) 상품입니다. 해외 상장 ETF는 ISA(개인종합자산관리계좌), 연금저축, IRP 계좌로 직접 살 수 없으며, 이러한 계좌들의 세제 혜택은 S&#038;P 500 지수를 추종하는 국내 상장 ETF로 받을 수 있습니다.</p>\n<p>해외 일반 계좌에서 투자할 때 발생하는 배당 및 매매차익 세제 구조와 계좌별 차이는 아래 표와 같습니다.</p>\n<table>\n<tr>\n<th>구분</th>\n<th>해외 상장 ETF (일반계좌)</th>\n<th>국내 상장 해외지수 ETF (일반계좌)</th>\n<th>ISA 일반형 (3년 유지)</th>\n<th>연금저축 (연금 수령)</th>\n</tr>\n<tr>\n<td>한 해 이익 200만 원 시 세금</td>\n<td>0원</td>\n<td>31만 원</td>\n<td>0원</td>\n<td>11만 원</td>\n</tr>\n<tr>\n<td>한 해 이익 500만 원 시 세금</td>\n<td>55만 원</td>\n<td>77만 원</td>\n<td>30만 원</td>\n<td>28만 원</td>\n</tr>\n<tr>\n<td>한 해 이익 1,000만 원 시 세금</td>\n<td>165만 원</td>\n<td>154만 원</td>\n<td>79만 원</td>\n<td>55만 원</td>\n</tr>\n<tr>\n<td>한 해 이익 2,000만 원 시 세금</td>\n<td>385만 원</td>\n<td>308만 원</td>\n<td>178만 원</td>\n<td>110만 원</td>\n</tr>\n</table>\n<p>세금 계산 방식을 구체적인 금액 예시로 살펴보면, 투자금 1억 원에 배당수익률 1.08%를 적용할 때 연 배당은 약 108만 원이 되며 미국 원천징수(배당·이자를 줄 때 세금을 미리 떼고 주는 것) 15%가 적용되어 세금 약 16만 원이 차감됩니다. 이자 및 배당 등 금융소득이 한 해 2,000만 원을 넘으면 넘는 부분은 다른 소득과 합쳐 금융소득종합과세 대상이 됩니다.</p>\n<p>매매차익의 경우 한 해 이익이 1,000만 원이라면 연 250만 원 기본 공제를 적용한 후 양도소득세 약 165만 원을 내게 됩니다. 이 양도소득세는 다음 해 5월에 직접 신고해야 하며 해외 주식의 이익과 손실을 합산하여 계산합니다. <a href=\"https://news.google.com/rss/articles/CBMiZ0FVX3lxTFA5ckVtVEM5c1dTaU94ZmZEaFRlamh5ZDBjaXk1YUJrNXAzUUhPUHhYZDdaUDktajFXRFk1Rmx6OE1DdVdfRnlrRmhpanNveFI0MGg2REHIAE1PRkhjNU81aGtvbUVxb2c?oc=5\" target=\"_blank\" rel=\"noopener\">자본시장뉴스</a> 보도에서도 제시하듯 종목별 상장 위치와 계좌 유형에 따라 실제 차감되는 세액 차이가 큽니다.</p>\n<p>시뮬레이션 그래프나 관련 산출 자료를 볼 때는 단순 평가금액의 증가세만 볼 것이 아니라, 매매차익 양도소득세 공제 차감 여부와 환율 변동이 원화 평가액에 미치는 영향을 복합적으로 읽어내야 합니다.</p>\n<div class=\"ondo-visual\" data-visual=\"backtest\" style=\"margin:26px 0;\">\n<div style=\"width: 100%; max-width: 700px; margin: 30px auto; overflow: visible !important;\">\n<p class=\"ondo-figtitle\" style=\"font-weight:700;margin:6px 0 8px;\">📊 Vanguard S&#038;P 500 ETF (VOO) 투자 시뮬레이션: 거치식 vs 적립식</p>\n<div id=\"backtest_chart_VOO\" role=\"img\" aria-label=\"Vanguard S&#038;P 500 ETF (VOO) 거치식 vs 적립식 투자 시뮬레이션 그래프, 10,000,000₩ 기준\" style=\"width:100%;min-height:420px;\"></div>\n<div style=\"display:flex; justify-content:center; flex-wrap:wrap; gap:8px; margin-top:5px; margin-bottom:15px;\"><button id=\"btn_lump_VOO\" type=\"button\" style=\"padding:8px 14px; border:1px solid #1f3c88; background:#fff; color:#1f3c88; cursor:pointer; border-radius:6px; font-weight:bold;\">거치식</button><button id=\"btn_dca_VOO\" type=\"button\" style=\"padding:8px 14px; border:1px solid #e67e22; background:#fff; color:#e67e22; cursor:pointer; border-radius:6px; font-weight:bold;\">적립식(DCA)</button></div>\n<p><script>(function(){  function initPlotly_VOO() {    var gd = document.getElementById(\"backtest_chart_VOO\");    if(!gd) return;    var data = [{\"type\": \"scatter\", \"mode\": \"lines\", \"x\": [\"2021-11\", \"2021-12\", \"2022-01\", \"2022-02\", \"2022-03\", \"2022-04\", \"2022-05\", \"2022-06\", \"2022-07\", \"2022-08\", \"2022-09\", \"2022-10\", \"2022-11\", \"2022-12\", \"2023-01\", \"2023-02\", \"2023-03\", \"2023-04\", \"2023-05\", \"2023-06\", \"2023-07\", \"2023-08\", \"2023-09\", \"2023-10\", \"2023-11\", \"2023-12\", \"2024-01\", \"2024-02\", \"2024-03\", \"2024-04\", \"2024-05\", \"2024-06\", \"2024-07\", \"2024-08\", \"2024-09\", \"2024-10\", \"2024-11\", \"2024-12\", \"2025-01\", \"2025-02\", \"2025-03\", \"2025-04\", \