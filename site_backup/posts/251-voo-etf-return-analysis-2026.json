, 910823.696459961, 922820.0644775392, 908602.5567626954, 903242.7510253907, 913230.9619995118, 945230.2832397461, 949087.1655273439, 935920.4102172853, 940615.1436401368, 941639.2833862306, 934390.8741088868, 933353.5501098634, 945336.5711059571, 943433.8067016603, 954167.7418090821, 953647.6962768555], \"name\": \"주봉\", \"visible\": false}];    var layout = {\"title\": \"Vanguard S&P 500 ETF (VOO) - 월봉\", \"yaxis\": {\"title\": \"가격 (₩)\"}, \"xaxis\": {\"title\": \"날짜\", \"type\": \"category\", \"rangeslider\": {\"visible\": false}, \"nticks\": 8, \"tickangle\": 0}, \"template\": \"plotly_white\", \"hovermode\": \"x unified\", \"height\": 450, \"margin\": {\"t\": 60, \"b\": 45, \"l\": 50, \"r\": 20}};    var config = {responsive: true, displaylogo: false};    Plotly.newPlot(gd, data, layout, config);    var btn_m = document.getElementById(\"btn_m_VOO\");    var btn_w = document.getElementById(\"btn_w_VOO\");    if(btn_m) btn_m.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [true, false]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 월봉\"}); });    if(btn_w) btn_w.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [false, true]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 주봉\"}); });  }  if(window.Plotly) initPlotly_VOO();  else if(!document.getElementById(\"plotly_script_VOO\")) {    var s = document.createElement(\"script\");    s.id = \"plotly_script_VOO\";    s.src = \"https://cdn.plot.ly/plotly-2.34.0.min.js\";    s.onload = initPlotly_VOO;    document.head.appendChild(s);  } else {    document.getElementById(\"plotly_script_VOO\").addEventListener(\"load\", initPlotly_VOO);  }})();</script></div>\n<p></div>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<h3 id=\"기간별-수익과-최대-낙폭의-기록\">기간별 수익과 최대 낙폭의 기록</h3>\n<p>최근 5년 연평균 수익률(CAGR, 여러 해의 수익을 매년 같은 비율로 불어났다고 보고 환산한 값, 배당 제외 기준)은 11.7%를 기록했습니다. 같은 최근 5년 기간 동안 고점 대비 가장 크게 떨어진 정도를 뜻하는 최대 낙폭(MDD)은 -24.52%였습니다.</p>\n<p>구체적인 경과를 보면 2022년 1월 3일 고점에서 시작해 2022년 10월 12일 바닥까지 약 281일 동안 하락하며 -24.52%의 낙폭을 기록했습니다. 이후 차츰 반등하여 2023년 12월 13일에 이전 고점 가격을 되찾았으며, 바닥을 찍고 회복하기까지는 약 427일이 소요되었습니다.</p>\n<p>하락장의 깊이와 길이를 이해하는 것은 보유 기간을 계획할 때 필수적입니다. 과거 하락 폭과 복구 시간을 통해 시장 변동을 참아내야 하는 기준 기간을 가늠할 수 있습니다.</p>\n<div class=\"ondo-visual\" data-visual=\"risk\" style=\"margin:26px 0;\">\n<p class=\"ondo-figtitle\" style=\"font-weight:700;margin:6px 0 8px;\">⚠️ 위기 시나리오: 최악의 경우 내 계좌는?</p>\n<p style=\"color:#555;\">각 ETF의 과거 실제 최대 낙폭(MDD)을 기준으로, 1억 원에 적용한 손실 규모입니다.</p>\n<div style=\"margin-top:20px;padding:15px;border:1px solid #ddd;border-left:4px solid #2166ac;border-radius:4px;background:#fff;\">\n<div style=\"padding:18px;border:1px solid #ddd;border-radius:8px;margin-bottom:12px;background:#fafafa;\">\n<p style=\"margin:0 0 10px;font-weight:bold;color:#333;font-size:15px;\">VOO</p>\n<div style=\"display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;\">\n<div><span style=\"font-size:12px;color:#5c6575;\">실제 최대낙폭(MDD)</span><br /><span style=\"font-size:17px;font-weight:bold;color:#2166ac;\">-24.52%</span></div>\n<div><span style=\"font-size:12px;color:#5c6575;\">최대 손실 금액</span><br /><span style=\"font-size:17px;font-weight:bold;color:#c0392b;\">-2,452만원</span></div>\n<div><span style=\"font-size:12px;color:#5c6575;\">잔여 자산</span><br /><span style=\"font-size:17px;font-weight:bold;color:#555;\">7,548만원</span></div>\n</div>\n</div>\n<p style=\"font-size:11px;color:#555;margin-top:10px;line-height:1.5;\">\n※ 가정이 아니라 해당 ETF의 최근 5년 실제 최대 낙폭(MDD)을 1억 원에 적용한 값입니다. 과거 낙폭이 앞으로의 최대 손실을 뜻하지는 않습니다.\n</p>\n</div>\n</div>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<div id=\"ondo-slot-1\" class=\"ondo-slot\"></div>\n<h3 id=\"배당의-흐름과-한국-투자자-세금\">배당의 흐름과 한국 투자자 세금</h3>\n<p>VOO는 3개월마다 주식의 배당과 비슷한 분배금을 지급하는 분기 배당 방식을 취합니다. 2026년 9월 28일 지급액은 1.8230 USD로 직전 분기 대비 -7.08% 감소했으나, 그 이전 회차인 2026년 6월 26일에는 1.9620 USD(+4.81%), 2026년 3월 27일에는 1.8720 USD(+5.70%), 2025년 12월 22일에는 1.7710 USD(+1.78%)를 기록했습니다.</p>\n<p>최근 4회 분배 중 1회는 직전 대비 줄어들었지만, 계절적 요인을 고려해 1년 전 같은 시기와 비교하면 결론이 다릅니다. 가장 최근 분배금(2026-09-28 1.8230 USD)은 1년 전 같은 시기(2025-09-29 1.7400 USD)보다 +4.77% 늘었습니다. 최근 20회 지급 내역 중 직전 회차보다 줄어든 횟수는 8회였지만, 그 전 1년 대비 최근 1년간의 배당 합계 증가율은 5.57%로 집계되었습니다.</p>\n<h4>🔸 매매차익과 배당에 부과되는 세금</h4>\n<p>달러로 거래되는 해외 상장 ETF이므로 환율 변화가 원화 수익률에 직접 영향을 미치는 환노출 상품입니다. 현재 원/달러 환율 1,333.40원 기준에서 과세 체계도 함께 고려해야 합니다.</p>\n<p>1억 원을 투자해 배당수익률 1.06%를 얻는다면 연간 배당은 약 106만 원이며, 세금을 떼고 받는 원천징수(미국 15%)에 따라 세금 약 16만 원이 발생합니다. 매매차익의 경우, 한 해 이익이 1,000만 원 발생 시 기본 공제 연 250만 원을 뺀 금액에 22%의 세율이 적용되어 양도소득세 약 165만 원을 다음 해 5월에 직접 신고해야 합니다.</p>\n<p>해외 주식 이익과 손실은 합산하여 계산되며, 이자·배당 등 금융소득이 한 해 2,000만 원을 넘으면 금융소득종합과세 대상이 되어 넘는 부분이 다른 소득과 합쳐 과세됩니다. 단, 해외 ETF 매매차익은 양도소득으로 분류되어 종합과세 합산 금액에는 포함되지 않습니다.</p>\n<p>거치식으로 한 번에 넣는 방식과 매달 나뉘어 넣는 적립식 방식은 주가 등락 구간에 따라 자산 평가액이 다르게 움직이므로, 본인의 자금 집행 형태에 맞춰 세금 및 환율 변동을 체크해야 합니다.</p>\n<div class=\"ondo-visual\" data-visual=\"backtest\" style=\"margin:26px 0;\">\n<div style=\"width: 100%; max-width: 700px; margin: 30px auto; overflow: visible !important;\">\n<p class=\"ondo-figtitle\" style=\"font-weight:700;margin:6px 0 8px;\">📊 Vanguard S&#038;P 500 ETF (VOO) 투자 시뮬레이션: 거치식 vs 적립식</p>\n<div id=\"backtest_chart_VOO\" role=\"img\" aria-label=\"Vanguard S&#038;P 500 ETF (VOO) 거치식 vs 적립식 투자 시뮬레이션 그래프, 10,000,000₩ 기준\" style=\"width:100%;min-height:420px;\"></div>\n<div style=\"display:flex; justify-content:center; flex-wrap:wrap; gap:8px; margin-top:5px; margin-bottom:15px;\"><button id=\"btn_lump_VOO\" type=\"button\" style=\"padding:8px 14px; border:1px solid #1f3c88; background:#fff; color:#1f3c88; cursor:pointer; border-radius:6px; font-weight:bold;\">거치식</button><button id=\"btn_dca_VOO\" type=\"button\" style=\"padding:8px 14px; border:1px solid #e67e22; background:#fff; color:#e67e22; cursor:pointer; border-radius:6px; font-weight:bold;\">적립식(DCA)</button></div>\n<p><script>(function(){  function initPlotly_VOO() {    var gd = docu