1\", \"2024-02\", \"2024-03\", \"2024-04\", \"2024-05\", \"2024-06\", \"2024-07\", \"2024-08\", \"2024-09\", \"2024-10\", \"2024-11\", \"2024-12\", \"2025-01\", \"2025-02\", \"2025-03\", \"2025-04\", \"2025-05\", \"2025-06\", \"2025-07\", \"2025-08\", \"2025-09\", \"2025-10\", \"2025-11\", \"2025-12\", \"2026-01\", \"2026-02\", \"2026-03\", \"2026-04\", \"2026-05\", \"2026-06\", \"2026-07\", \"2026-08\", \"2026-09\", \"2026-10\"], \"y\": [166667, 340934, 489733, 641803, 832788, 926300, 1095364, 1171504, 1445940, 1552904, 1576721, 1871379, 2141065, 2184997, 2489104, 2593583, 2856472, 3068559, 3250005, 3628243, 3914283, 4017213, 3993305, 4073231, 4613430, 4991328, 5238213, 5677637, 6030536, 5955454, 6421424, 6817153, 7062878, 7398601, 7726282, 7819739, 8446909, 8416456, 8809933, 8865150, 8534655, 8632070, 9340971, 9990820, 10385963, 10768206, 11317090, 11754681, 11947029, 12123103, 12465489, 12530663, 12069770, 13509564, 14390176, 14418631, 14581939, 15135956, 15254784, 15733573], \"name\": \"적립식 (매달 분할 투자)\", \"visible\": false, \"line\": {\"color\": \"#e67e22\", \"width\": 3}}];    var layout = {\"title\": \"Vanguard S&P 500 ETF (VOO) - 10,000,000₩ 거치식 시뮬레이션\", \"yaxis\": {\"title\": \"평가금액 (₩)\"}, \"xaxis\": {\"title\": \"투자 개월\", \"type\": \"category\", \"nticks\": 8, \"tickangle\": 0}, \"template\": \"plotly_white\", \"hovermode\": \"x unified\", \"height\": 420, \"margin\": {\"t\": 60, \"b\": 45, \"l\": 60, \"r\": 20}};    var config = {responsive: true, displaylogo: false};    Plotly.newPlot(gd, data, layout, config);    var btn_lump = document.getElementById(\"btn_lump_VOO\");    var btn_dca = document.getElementById(\"btn_dca_VOO\");    if(btn_lump) btn_lump.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [true, false]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 10,000,000₩ 거치식 시뮬레이션\"}); });    if(btn_dca) btn_dca.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [false, true]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 월 166,667₩ 적립식 시뮬레이션\"}); });  }  if(window.Plotly) initPlotly_VOO();  else if(!document.getElementById(\"backtest_plotly_script_VOO\")) {    var s = document.createElement(\"script\");    s.id = \"backtest_plotly_script_VOO\";    s.src = \"https://cdn.plot.ly/plotly-2.34.0.min.js\";    s.onload = initPlotly_VOO;    document.head.appendChild(s);  } else {    document.getElementById(\"backtest_plotly_script_VOO\").addEventListener(\"load\", initPlotly_VOO);  }})();</script></p>\n<p style=\"font-size:12px;color:#888;margin-top:8px;text-align:center;\">※ 최근 5년 실제 가격 데이터를 기반으로, 10,000,000₩을 처음에 한 번에 투자(거치식)했을 때와 매달 나누어 투자(적립식)했을 때의 평가금액 변화를 비교한 시뮬레이션입니다. 배당 재투자, 세금, 환율 변동은 반영되지 않았습니다.</p>\n</div>\n</div>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<h3 id=\"자주-묻는-질문\">자주 묻는 질문</h3>\n<h4>🔸 VOO 같은 해외 상장 ETF는 국내 연금저축이나 개인종합자산관리계좌(ISA)로 직접 살 수 없나요?</h4>\n<p>해외에 직접 상장된 ETF는 개인종합자산관리계좌(ISA), 연금저축, 개인형퇴직연금(IRP) 등 절세 계좌에서 직접 살 수 없습니다. 이러한 계좌의 세제 혜택을 받으려면 동일한 S&#038;P 500 지수를 추종하는 국내 상장 해외지수 ETF를 통해서 수혜를 적용받는 방식이 있습니다.</p>\n<h4>🔸 배당 지급액이 직전 분기보다 줄어든 적이 있는데 배당 삭감으로 봐야 하나요?</h4>\n<p>기업들의 배당 지급 시기가 분기마다 일정하지 않기 때문에 단순 직전 회차 비교 시 금액이 줄어들 수 있습니다. VOO의 경우 최근 20회 지급 중 직전 대비 줄어든 횟수가 8회 존재하지만, 최근 1년 배당 합계는 그 전 1년 대비 5.57% 증가하여 연간 기준의 배당 성장 추세는 다르게 읽힐 수 있습니다.</p>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<div id=\"ondo-slot-2\" class=\"ondo-slot\"></div>\n<h3 id=\"정리\">정리</h3>\n<p>해외 상장 상품인 VOO는 0.03%의 적은 보수와 S&#038;P 500 지수 추종이라는 명확한 목표를 지니고 있습니다. 과거 5년 동안 -24.52%의 낙폭을 기록한 뒤 전고점 회복까지 427일이 걸렸던 실제 기록처럼, 장기 투자 과정에서의 변동성 구간을 수치로 감내할 수 있는지 파악해야 합니다.</p>\n<p>앞으로 유사한 해외 ETF 뉴스나 실적 숫자를 살펴볼 때는 다음 세 가지 기준을 확인해 보는 것이 도움이 됩니다.</p>\n<p>1. 배당 변동을 볼 때 단기 직전 회차 감소에 흔들리지 않고 &#8216;1년 전 같은 시기 대비 변화&#8217; 및 &#8216;최근 1년 배당 합계 증가율(VOO 5.57%)&#8217;을 함께 비교하기</p>\n<p>2. 최대 낙폭(MDD -24.52%)과 함께 바닥에서 고점까지 되찾는 데 걸린 회복 기간(약 427일)을 점검하기</p>\n<p>3. 매매차익 발생 시 연간 공제액 250만 원 초과분 세율(22%)과 미국 원천징수 배당세율(15%)을 자산 규모별로 사전 계산하기</p>\n<p><strong>한 줄 정리:</strong> VOO는 낮은 보수(0.03%)와 명확한 지수 추종이 장점이지만, -24.52%의 낙폭 복구 기간과 22%의 양도소득세 구조를 미리 파악해야 합니다.</p>\n<div style=\"margin-top:30px;padding:16px;background:#f8f9fa;border-radius:6px;font-size:13px;line-height:1.7;\"><strong>📌 데이터 출처</strong><br />ETF 가격·배당: Yahoo Finance, 국내 ETF 정보: 네이버 금융·KRX, 그래프·표: ondo가 위 자료로 직접 계산<br />직접 확인: <a href=\"https://finance.yahoo.com/quote/VOO\" target=\"_blank\" rel=\"noopener nofollow\">VOO Yahoo Finance</a></p>\n<ul style=\"margin:8px 0 0 18px;\">\n<li><a href=\"https://news.google.com/rss/articles/CBMiakFVX3lxTE9CUWdTWXF5dzlsbzFuSS1zOFRSXy1wZ2F2eWh0NjhOWG15djlsLTBYMlBreS1ua29MN3YtQk9mZnVFYm1yQnRpQU90elphdjhJQVA2bmtCRzJubWh5RmdmNmhjRGw5WDd2MWc?oc=5\" target=\"_blank\" rel=\"noopener\">Investing.com 한국어</a> &#8211; 10월 CPI 보고서에 전문가·애널리스트들 &quot;예상보다 뜨겁다&quot; &#8211; Investing.com 한국어</li>\n<li><a href=\"https://news.google.?oc=5\" target=\"_blank\" rel=\"noopener\">TradingKey</a> &#8211; VOO 주식: 뱅가드 S&amp;P 500 ETF가 여전히 현명한 장기 투자처인 이유 &#8211; TradingKey</li>\n<li><a href=\"https://news.google.?oc=5\" target=\"_blank\" rel=\"noopener\">IDNFinancials</a> &#8211; Vanguard ETF의 실적은 최고 중 하나인데, 그 이유는 무엇일까요? &#8211; IDNFinancials</li>\n<li><a href=\"https://news.google.com/rss/articles/CBMiXEFVX3lxTE5NVEJGSGVvYWpfU1BKeld0eDEzMGNRZlJ5N1VtM3ZWbXgtZ2xSd0VzWmlnRWRHUzNYTEFxUkUzRGt2eGR4Wl9ncDUzdEdPaGVuNk9TVEZzYTVoYVFE?oc=5\" target=\"_blank\" rel=\"noopener\">뉴스핌</a> &#8211; [ETF 특징주] JP모간 연말 S&amp;P500 전망 상향에 SPY·VOO 조명 &#8211; 뉴스핌</li>\n<li><a href=\"https://news.google.com/rss/articles/CBMiZ0FVX3lxTFA5ckVtVEM5c1dTaU94ZmZEaFRlamh5ZDBjaXk1YUJrNXAzUUhPUHhYZDdaUDktajFXRFk1Rmx6OE1DdVdfRnlrRmhpanNveFI0MGg2REhIQU1PRkhjNU81aGtvbUVxb2c?oc=5\" target=\"_blank\" rel=\"noopener\">자본시장뉴스</a> &#8211; [주린이를 위한 썰] “SPY·VOO·SPYM 뭐가 달라”… S&amp;P 500 ETF 고르는 법 &#8211; 자본시장뉴스</li>\n<li><a href=\"https://news.google.com/rss/articles/CBMiWEFVX3lxTE5oTmhseVREZzlyUjFvRk5RdHl6RjkwZGF4SUswRXNkRk