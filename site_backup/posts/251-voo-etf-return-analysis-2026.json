\": false}];    var layout = {\"title\": \"Vanguard S&P 500 ETF (VOO) - 월봉\", \"yaxis\": {\"title\": \"가격 (₩)\"}, \"xaxis\": {\"title\": \"날짜\", \"type\": \"category\", \"rangeslider\": {\"visible\": false}, \"nticks\": 8, \"tickangle\": 0}, \"template\": \"plotly_white\", \"hovermode\": \"x unified\", \"height\": 450, \"margin\": {\"t\": 60, \"b\": 45, \"l\": 50, \"r\": 20}};    var config = {responsive: true, displaylogo: false};    Plotly.newPlot(gd, data, layout, config);    var btn_m = document.getElementById(\"btn_m_VOO\");    var btn_w = document.getElementById(\"btn_w_VOO\");    if(btn_m) btn_m.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [true, false]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 월봉\"}); });    if(btn_w) btn_w.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [false, true]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 주봉\"}); });  }  if(window.Plotly) initPlotly_VOO();  else if(!document.getElementById(\"plotly_script_VOO\")) {    var s = document.createElement(\"script\");    s.id = \"plotly_script_VOO\";    s.src = \"https://cdn.plot.ly/plotly-2.34.0.min.js\";    s.onload = initPlotly_VOO;    document.head.appendChild(s);  } else {    document.getElementById(\"plotly_script_VOO\").addEventListener(\"load\", initPlotly_VOO);  }})();</script></div>\n<p></div>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<div id=\"ondo-slot-2\" class=\"ondo-slot\"></div>\n<h3 id=\"정리\">정리</h3>\n<p>VOO는 0.03%의 낮은 운용보수와 약 1조 7,357억 달러 규모의 높은 순자산을 바탕으로 미국 S&#038;P 500 지수를 추종합니다. 최근 5년 연평균 수익률 11.7%를 기록했으나 같은 기간 -24.52%의 최대 낙폭을 경험했으며 이를 회복하는 데 약 427일이 소요되었습니다. 해외 상장 ETF 특성상 원/달러 환율에 영향을 받으며 매매차익은 연 250만 원 공제 후 22% 양도소득세 대상이 됩니다.</p>\n<p>독자가 향후 해외 ETF 성과와 세금을 직접 확인할 때는 최근 5년 최대 낙폭(MDD)과 전고점 회복 기간, 직전 회차 대비 배당 변동률과 1년 전 같은 시기 대비 증가율, 그리고 연간 매매차익 250만 원 공제 한도 도달 여부 등 3가지 기준을 숫자로 살펴보는 것이 유용합니다.</p>\n<p><strong>한 줄 정리:</strong> VOO는 연보수 0.03%의 저비용 상품이나 24.52%의 낙폭과 22%의 양도세 구조를 수치로 확인해야 합니다.</p>\n<div style=\"margin-top:30px;padding:16px;background:#f8f9fa;border-radius:6px;font-size:13px;line-height:1.7;\"><strong>📌 데이터 출처</strong><br />ETF 가격·배당: Yahoo Finance, 국내 ETF 정보: 네이버 금융·KRX, 그래프·표: ondo가 위 자료로 직접 계산<br />직접 확인: <a href=\"https://finance.yahoo.com/quote/VOO\" target=\"_blank\" rel=\"noopener nofollow\">VOO Yahoo Finance</a></p>\n<ul style=\"margin:8px 0 0 18px;\">\n<li><a href=\"https://news.google.com/rss/articles/CBMiakFVX3lxTE9CUWdTWXF5dzlsbzFuSS1zOFRSXy1wZ2F2eWh0NjhOWG15djlsLTBYMlBreS1ua29MN3YtQk9mZnVFYm1yQnRpQU90elphdjhJQVA2bmtCRzJubWh5RmdmNmhjRGw5WDd2MWc?oc=5\" target=\"_blank\" rel=\"noopener\">Investing.com 한국어</a> &#8211; 10월 CPI 보고서에 전문가·애널리스트들 &quot;예상보다 뜨겁다&quot; &#8211; Investing.com 한국어</li>\n<li><a href=\"https://news.google.?oc=5\" target=\"_blank\" rel=\"noopener\">TradingKey</a> &#8211; VOO 주식: 뱅가드 S&amp;P 500 ETF가 여전히 현명한 장기 투자처인 이유 &#8211; TradingKey</li>\n<li><a href=\"https://news.google.?oc=5\" target=\"_blank\" rel=\"noopener\">IDNFinancials</a> &#8211; Vanguard ETF의 실적은 최고 중 하나인데, 그 이유는 무엇일까요? &#8211; IDNFinancials</li>\n<li><a href=\"https://news.google.com/rss/articles/CBMiXEFVX3lxTE5NVEJGSGVvYWpfU1BKeld0eDEzMGNRZlJ5N1VtM3ZWbXgtZ2xSd0VzWmlnRWRHUzNYTEFxUkUzRGt2eGR4Wl9ncDUzdEdPaGVuNk9TVEZzYTVoYVFE?oc=5\" target=\"_blank\" rel=\"noopener\">뉴스핌</a> &#8211; [ETF 특징주] JP모간 연말 S&amp;P500 전망 상향에 SPY·VOO 조명 &#8211; 뉴스핌</li>\n<li><a href=\"https://news.google.com/rss/articles/CBMiZ0FVX3lxTFA5ckVtVEM5c1dTaU94ZmZEaFRlamh5ZDBjaXk1YUJrNXAzUUhPUHhYZDdaUDktajFXRFk1Rmx6OE1DdVdfRnlrRmhpanNveFI0MGg2REhIQU1PRkhjNU81aGtvbUVxb2c?oc=5\" target=\"_blank\" rel=\"noopener\">자본시장뉴스</a> &#8211; [주린이를 위한 썰] “SPY·VOO·SPYM 뭐가 달라”… S&amp;P 500 ETF 고르는 법 &#8211; 자본시장뉴스</li>\n<li><a href=\"https://news.google.com/rss/articles/CBMiWEFVX3lxTE5oTmhseVREZzlyUjFvRk5RdHl6RjkwZGF4SUswRXNkRklFY0Q3M2E0cXhoYUkxYlZXQUtxS0Q5T1RXOUhhS2pMNWVjZVZnY1lhQUFGQ3U2SDY?oc=5\" target=\"_blank\" rel=\"noopener\">네이버페이 머니스토리</a> &#8211; 환율이 오르면 돈 벌 수 있다고? 킹달러 시대 주목할 달러선물 ETF 총정리 &#8211; 네이버페이 머니스토리</li>\n</ul>\n</div>\n<p style=\"margin-top:20px;font-size:12px;color:#5c6575;line-height:1.7;\">이 글은 공개 데이터를 정리한 정보 제공용 글이며, 특정 상품의 매수·매도를 권유하지 않습니다. 투자 판단과 책임은 본인에게 있습니다.</p>\n",
