941814.3679870605, 942839.8134460448, 935582.1629089355, 934543.5163879393, 946541.8149719237, 937707.4524047851], \"name\": \"주봉\", \"visible\": false}];    var layout = {\"title\": \"Vanguard S&P 500 ETF (VOO) - 월봉\", \"yaxis\": {\"title\": \"가격 (₩)\"}, \"xaxis\": {\"title\": \"날짜\", \"type\": \"category\", \"rangeslider\": {\"visible\": false}, \"nticks\": 8, \"tickangle\": 0}, \"template\": \"plotly_white\", \"hovermode\": \"x unified\", \"height\": 450, \"margin\": {\"t\": 60, \"b\": 45, \"l\": 50, \"r\": 20}};    var config = {responsive: true, displaylogo: false};    Plotly.newPlot(gd, data, layout, config);    var btn_m = document.getElementById(\"btn_m_VOO\");    var btn_w = document.getElementById(\"btn_w_VOO\");    if(btn_m) btn_m.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [true, false]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 월봉\"}); });    if(btn_w) btn_w.addEventListener(\"click\", function(){ Plotly.restyle(gd, {\"visible\": [false, true]}); Plotly.relayout(gd, {\"title.text\": \"Vanguard S&P 500 ETF (VOO) - 주봉\"}); });  }  if(window.Plotly) initPlotly_VOO();  else if(!document.getElementById(\"plotly_script_VOO\")) {    var s = document.createElement(\"script\");    s.id = \"plotly_script_VOO\";    s.src = \"https://cdn.plot.ly/plotly-2.34.0.min.js\";    s.onload = initPlotly_VOO;    document.head.appendChild(s);  } else {    document.getElementById(\"plotly_script_VOO\").addEventListener(\"load\", initPlotly_VOO);  }})();</script></div>\n</div>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<h3 id=\"배당금-현황과-배당-성장성\">배당금 현황과 배당 성장성</h3>\n<p> VOO는 분기별로 배당금을 지급하며 연 환산 배당수익률은 1.07% 수준입니다. 최근 4회 중 1회는 배당 지급액이 직전 대비 감소했습니다. </p>\n<table>\n<tr>\n<th>지급일</th>\n<th>배당금(USD)</th>\n<th>직전 대비 변동률</th>\n</tr>\n<tr>\n<td>2025-12-22</td>\n<td>1.7710</td>\n<td>+1.78%</td>\n</tr>\n<tr>\n<td>2026-03-27</td>\n<td>1.8720</td>\n<td>+5.70%</td>\n</tr>\n<tr>\n<td>2026-06-26</td>\n<td>1.9620</td>\n<td>+4.81%</td>\n</tr>\n<tr>\n<td>2026-09-28</td>\n<td>1.8230</td>\n<td>-7.08%</td>\n</tr>\n</table>\n<p> 단기적인 분기 배당금의 변동에도 불구하고 VOO의 장기 배당성장률은 5.57%를 기록하고 있습니다. 이는 지수 구성 종목들의 이익 성장과 배당 확대가 시차를 두고 반영되는 구조적 특징에 기반합니다. </p>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<h3 id=\"보수-비용과-투자-매력도-분석\">보수 비용과 투자 매력도 분석</h3>\n<p> VOO의 운용보수는 연 0.03%로 글로벌 ETF 중 최저 수준입니다. 보수 비용의 차이는 장기 투자 시 수익률에 직접적인 영향을 미칩니다. 0.1%포인트의 보수 차이라도 1억 원을 10년간 투자할 경우 약 998,204원의 잠재적 손실 차이를 발생시킵니다. 투자 매력도 점수는 총 6.9점으로 평가됩니다. 항목별로는 낮은 운용보수로 +1.5점, 보통 수준의 MDD로 0점, 강세인 배당성장률로 +1.0점을 얻었으나 높은 환노출 리스크 영향으로 -0.6점이 반영된 결과입니다. <a href=\"https://news.google.com/rss/articles/CBMioAFBVV95cUxQTmlfNkNmSnc5eHlIaG55Mzlkd2dmR1dyZUxiWFZEV2xBZl9sQ2VKN2VhaUIxNHlBdjJmX1B1Q3daRm9HcFNqRjdMd3JnNGtKRkwwUGd3VnVhb1UxNjZDcWp6NHpjR1ZOQ2RjaWJWaVRzZXk3QllBZUlGbnBFblNXNXZyNGxCQU90ZUtjMkctZTZrUnpKSVhEQ1VDbkIyRFZm?oc=5\" target=\"_blank\" rel=\"noopener\">TradingKey</a>에 따르면 S&#038;P 500 ETF 자산이 사상 처음으로 1조 달러를 돌파하는 과정에서 뱅가드 VOO가 글로벌 기록을 수립하기도 했습니다. 실제 비용 비교 자료를 볼 때는 단순 운용보수뿐만 아니라 기타 수수료와 매매 비용까지 합산된 총비용을 고려하여 비용 효율성을 판단해야 합니다. </p>\n<div class=\"ondo-visual\" data-visual=\"fees\" style=\"margin:26px 0;\">\n<p class=\"ondo-figtitle\" style=\"font-weight:700;margin:6px 0 8px;\">💰 계좌별 실수료 비교: 1억 원 투자 시 실제 비용</p>\n<p style=\"color:#555;\">해외(미국 등) 상장 ETF는 ISA·연금저축·IRP 계좌로 직접 살 수 없습니다. 이 계좌들의 세제 혜택을 쓰려면 같은 지수를 추종하는 국내 상장 ETF를 사야 합니다. 아래 표는 직접 투자와, 같은 지수의 국내 상장 ETF를 계좌별로 샀을 때를 비교합니다.</p>\n<table style=\"width:100%;border-collapse:collapse;font-size:12px;margin-top:15px;\">\n<tr style=\"background:#f0f7ff;\">\n<th style=\"border:1px solid #ddd;padding:12px;text-align:center;\">계좌 유형</th>\n<th style=\"border:1px solid #ddd;padding:12px;text-align:center;\">세금 부담</th>\n<th style=\"border:1px solid #ddd;padding:12px;text-align:center;\">운용보수<br />(10년 누적)</th>\n<th style=\"border:1px solid #ddd;padding:12px;text-align:center;\">총 비용</th>\n<th style=\"border:1px solid #ddd;padding:12px;text-align:center;\">실제 수익률</th>\n</tr>\n<tr>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;font-weight:bold;color:#2166ac;\">해외 직접투자(일반계좌)</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#2166ac;font-weight:bold;\">22%</span><br />\n    <span style=\"font-size:10px;color:#666;\">250만 원 공제 후 매매차익</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#e67e22;font-weight:bold;\">524,983원</span><br />\n    <span style=\"font-size:10px;color:#666;\">(연 0.03%)</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#2166ac;font-weight:bold;\">45,949,381원</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#c0392b;font-weight:bold;\">10.2%</span>\n</td>\n</tr>\n<tr>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;font-weight:bold;color:#7f8c8d;\">국내 상장 같은 지수 ETF(일반계좌)</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#7f8c8d;font-weight:bold;\">15.4%</span><br />\n    <span style=\"font-size:10px;color:#666;\">매매차익·분배금</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#e67e22;font-weight:bold;\">524,983원</span><br />\n    <span style=\"font-size:10px;color:#666;\">(연 0.03%)</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#2166ac;font-weight:bold;\">32,707,061원</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#c0392b;font-weight:bold;\">10.7%</span>\n</td>\n</tr>\n<tr>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;font-weight:bold;color:#c0392b;\">국내 상장 같은 지수 ETF(ISA)</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#c0392b;font-weight:bold;\">9.9%</span><br />\n    <span style=\"font-size:10px;color:#666;\">200만 원 초과분</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#e67e22;font-weight:bold;\">524,983원</span><br />\n    <span style=\"font-size:10px;color:#666;\">(연 0.03%)</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#2166ac;font-weight:bold;\">21,015,462원</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#c0392b;font-weight:bold;\">11.2%</span>\n</td>\n</tr>\n<tr>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;font-weight:bold;color:#f39c12;\">국내 상장 같은 지수 ETF(연금저축/IRP)</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#f39c12;font-weight:bold;\">3.3~5.5%</span><br />\n    <span style=\"font-size:10px;color:#666;\">연금 수령 시</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#e67e22;font-weight:bold;\">524,983원</span><br />\n    <span style=\"font-size:10px;color:#666;\">(연 0.03%)</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#2166ac;font-weight:bold;\">12,018,582원</span>\n</td>\n<td style=\"border:1px solid #ddd;padding:12px;text-align:center;\">\n    <span style=\"color:#c0392b;font-weight:bold;\">11.5%</span>\n</td>\n</tr>\n</table>\n<p style=\"font-size:11px;color:#888;margin-top:15px;line-height:1.6;\">\n<strong>💡 계산 기준:</strong><br />\n&#8211; 투자원금: 1억 원<br />\n&#8211; 연 수익률: 11.9% (과거 실제 데이터 반영)<br />\n&#8211; 운용보수: ETF 평균 0.03% 적용<br />\n&#8211; 세금: 2026년 10월 기준 세법, 10년 뒤 한 번에 매도한다고 단순 가정 (연금은 최고 세율 5.5% 적용)<br />\n&#8211; ISA는 연 2,000만 원 납입 한도가 있어 1억 원을 한 번에 넣을 수 없습니다. 세율 차이를 보여주기 위한 비교입니다.<br />\n&#8211; 국내 주식형 ETF의 매매차익은 일반계좌에서도 비과세라, 그 경우 일반계좌 세금은 이보다 적습니다.\n</p>\n</div>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<div id=\"ondo-slot-1\" class=\"ondo-slot\"></div>\n<h3 id=\"한국-투자자-주의사항과-세금\">한국 투자자 주의사항과 세금</h3>\n<p> VOO는 미국 거래소에 상장된 해외 상장 ETF입니다. 원화로 직접 매수할 수 없으며 달러로 거래되므로 환노출 위험을 항상 수반합니다. 환율 변동에 따라 주가 상승분 상쇄되거나 추가 손익이 발생할 수 있습니다. 세금 제도에서도 국내 상장 상품과 명확한 차이가 존재합니다. 과세계좌에서 연 배당금 1억 원을 산정할 경우 미국 현지 원천징수 세율 15%가 적용되어 1,500만 원 수준의 세금이 발생합니다. 매매차익은 연 250만 원 기본공제 후 22%의 양도소득세가 부과되며 다음 해 5월에 직접 신고해야 합니다. 해외 상장 ETF는 ISA, 연금저축, IRP 계좌로 직접 살 수 없습니다. 이 계좌들의 세제 혜택을 쓰려면 같은 지수를 추종하는 국내 상장 ETF를 사야 합니다. </p>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<h3 id=\"자주-묻는-질문\">자주 묻는 질문</h3>\n<h4>🔸 VOO ETF의 운용보수는 얼마인가요?</h4>\n<p> VOO의 연간 운용보수는 0.03%입니다. 동일한 S&#038;P 500 지수를 추종하는 다른 경쟁 ETF들과 비교해서도 매우 저렴한 수준입니다. </p>\n<h4>🔸 VOO 배당금은 얼마나 자주 나오나요?</h4>\n<p> VOO는 분기 배당을 실시하며 3월, 6월, 9월, 12월 연 4회 지급됩니다. 지급 시기별로 상장기업들의 배당 일정에 따라 분기별 지급액에는 차이가 발생할 수 있습니다. </p>\n<h4>🔸 국내 계좌로 VOO를 직접 매수할 수 있나요?</h4>\n<p> 일반 증권사 해외주식 거래 계좌를 통해서는 달러로 매수할 수 있습니다. 하지만 ISA, 연금저축, IRP 같은 절세 계좌 내에서는 해외 상장 ETF인 VOO를 직접 매수할 수 없습니다. </p>\n<div style=\"width:100%; height:1px; background-color:#ddd; margin:40px 0;\"></div>\n<div id=\"ondo-slot-2\" class=\"ondo-slot\"></div>\n<h3 id=\"정리\">정리</h3>\n<p> S&#038;P 500 지수를 추종하는 VOO는 미국 시장의 성장을 가장 효율적이고 저렴한 비용으로 향유할 수 있는 장기 투자자의 핵심 자산입니다. 연 0.03%의 저렴한 운용보수와 오랜 기간 검증된 지수 추종 능력은 포트폴리오의 기초 체력을 다지는 주력 자산으로 적합합니다. 다만 해외 상장 ETF 특성상 달러 환율 변동에 따른 환노출 위험과 22%의 양도소득세 과세 체계를 정확히 이해해야 합니다. 개인연금이나 ISA 계좌를 활용해 세제 혜택을 받고자 하는 경우라면 국내 상장된 동일 지수 ETF를 대안으로 검토하는 것이 바람직합니다. </p>\n<div style=\"margin-top:30px;padding:16px;background:#f8f9fa;border-radius:6px;font-size:13px;line-height:1.7;\"><strong>📌 데이터 출처</strong><br />ETF 가격·배당: Yahoo Finance, 국내 ETF 정보: 네이버 금융·KRX, 그래프·표: ondo가 위 자료로 직접 계산</p>\n<ul style=\"margin:8px 0 0 18px;\">\n<li><a href=\"https://news.google.com/rss/articles/CBMioAFBVV95cUxQTmlfNkNmSnc5eHlIaG55Mzlkd2dmR1dyZUxiWFZEV2xBZl9sQ2VKN2VhaUIxNHlBdjJmX1B1Q3daRm9HcFNqRjdMd3JnNGtKRkwwUGd3VnVhb1UxNjZDcWp6NHpjR1