# ============================================================
# 통합 키 파일 (.env)
#
# 이 파일 하나에 모든 API 키/토큰을 모아둡니다. 로컬에서 실행할 때는 이 파일을
# 복사해서 ".env"라는 이름으로 저장하고 아래 값들을 실제 값으로 채우면 됩니다.
#
# [GitHub Actions에서 쓰는 법] 이 파일을 다 채운 뒤, 파일 전체 내용을 그대로
# 복사해서 GitHub 저장소의 Settings > Secrets and variables > Actions에
# "DOTENV_CONTENTS"라는 이름의 시크릿 하나로 등록하세요. 워크플로우가 실행될
# 때마다 이 시크릿 내용을 그대로 .env 파일로 복원해서 쓰기 때문에, 시크릿을
# 하나하나 따로 등록할 필요가 없습니다. (자세한 방법은 GITHUB_ACTIONS_GUIDE.md
# 4단계 참고)
#
# 이 파일(.env)과 실제 값이 채워진 사본은 절대 깃허브에 커밋하지 마세요.
# (.gitignore에 이미 .env가 등록되어 있어 실수로 커밋되는 걸 막아줍니다.)
# ============================================================

# ------------------------------------------------------------
# 필수 - 워드프레스 발행
# ------------------------------------------------------------
# 발행 대상 워드프레스 사이트 주소 (예: https://ondo99.com)
WP_SITE_URL=

# OAuth2 액세스 토큰 (public-api.wordpress.com API 자동발행용)
# 발급 방법: get_wp_oauth_token.py 참고
WP_OAUTH_TOKEN=

# 숫자형 사이트 ID
WP_SITE_ID=

# ------------------------------------------------------------
# 선택 - Selenium 완전자동 발행용 로그인 정보 (API가 막혔을 때 예비 경로)
# ------------------------------------------------------------
WP_EMAIL=
WP_PASSWORD=

# ------------------------------------------------------------
# 필수 - 글 생성 (Gemini)
# ------------------------------------------------------------
# 쉼표(,)로 여러 키를 넣으면 한 키가 한도초과일 때 자동으로 다음 키로 전환합니다.
# 예: GEMINI_API_KEY=키1,키2,키3
# (선택) 키 앞에 "이름표:"를 붙이면, 그 키가 거부될 때 텔레그램에 이름표로 알려줍니다
#        (어느 계정 키를 다시 받아야 하는지 바로 알 수 있게). 이름표는 이메일이든 별명이든 아무거나.
# 예: GEMINI_API_KEY=aa@gmail.com:키1,bb@gmail.com:키2,메인:키3
#     이름표는 텔레그램(개인 채팅)에만 나오고, 공개 저장소의 logs/ 기록에는 "키 N번"만 남습니다.
GEMINI_API_KEY=

# (선택) 글쓰기·고쳐쓰기에 쓸 좋은 모델 순서. 비워두면 gemini-3.6-flash → gemini-3.5-flash.
# 이 모델들이 한도에 막히면 글을 섹션별로 나눠 키를 분산해서 쓰고, 그래도 막히면 아래 넉넉한 모델로 내려갑니다.
WRITER_MODEL_PRIORITY=

# (선택) 사용할 모델을 하나만 고정하고 싶을 때. 비워두면 GEMINI_MODEL_PRIORITY 적용.
GEMINI_MODEL=

# (선택) 모델 자동 로테이션 우선순위. aistudio.google.com/rate-limit에서 확인 후 갱신 권장.
# 예: GEMINI_MODEL_PRIORITY=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash
GEMINI_MODEL_PRIORITY=

# ------------------------------------------------------------
# 필수 - 텔레그램 (ETF 승인 요청 + 4개 카테고리 공통 발행 알림)
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# 필수(테크/바이오/특허) - 본문 이미지 삽입
# ------------------------------------------------------------
# https://unsplash.com/developers 에서 무료 발급
UNSPLASH_ACCESS_KEY=

# ------------------------------------------------------------
# 선택 - ETF 홍보(Threads 카드뉴스)
# ------------------------------------------------------------
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ------------------------------------------------------------
# 선택 - ETF 성과분석 부서(Google Search Console 연동)
# ------------------------------------------------------------
# 서비스 계정 JSON 키 파일의 내용 전체를 한 줄로 붙여넣으세요.
GSC_SERVICE_ACCOUNT_JSON=
GSC_SITE_URL=

# ------------------------------------------------------------
# 선택 - 예전 티스토리 플랫폼 (PLATFORM=tistory로 쓸 때만 필요, 지금은 안 씀)
# ------------------------------------------------------------
TISTORY_ID=
TISTORY_PW=
BLOG_NAME=

# ------------------------------------------------------------
# 아래는 "시크릿"이 아니라 실행 설정값입니다. GitHub Actions에서는 워크플로우
# 파일(.github/workflows/*.yml)의 env: 블록에서 잡(job)마다 다르게 이미
# 지정해주므로, 이 .env 파일에는 굳이 안 넣어도 됩니다 - 로컬에서 직접 실행할
# 때 필요하면 아래 주석을 풀고 값을 채우세요.
# ------------------------------------------------------------
# PLATFORM=wordpress
# CHART_MODE=script
# MIN_PUBLISH_INTERVAL_HOURS=20
# NONINTERACTIVE=1
# BLOG_CATEGORY=etf
# REMINDER_MAX_DAYS=3
# KEEP_RAW_RESPONSES=1
